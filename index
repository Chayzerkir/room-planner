  // ---------------------------------------------------------------
  // Geometry helpers
  // ---------------------------------------------------------------
  function polyArea(pts) {
    let s = 0;
    for (let i = 0; i < pts.length; i++) { const a = pts[i], b = pts[(i + 1) % pts.length]; s += a.x * b.y - b.x * a.y; }
    return Math.abs(s) / 2;
  }
  function polyPerimeter(pts) {
    let s = 0;
    for (let i = 0; i < pts.length; i++) { const a = pts[i], b = pts[(i + 1) % pts.length]; s += Math.hypot(a.x - b.x, a.y - b.y); }
    return s;
  }
  function polyCentroid(pts) {
    let a2 = 0, cx = 0, cy = 0;
    for (let i = 0; i < pts.length; i++) {
      const p = pts[i], q = pts[(i + 1) % pts.length];
      const cr = p.x * q.y - q.x * p.y;
      a2 += cr; cx += (p.x + q.x) * cr; cy += (p.y + q.y) * cr;
    }
    if (Math.abs(a2) < 1e-6) {
      return { x: pts.reduce((s, p) => s + p.x, 0) / pts.length, y: pts.reduce((s, p) => s + p.y, 0) / pts.length };
    }
    return { x: cx / (3 * a2), y: cy / (3 * a2) };
  }
  function pointInPoly(x, y, pts) {
    let inside = false;
    for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
      const xi = pts[i].x, yi = pts[i].y, xj = pts[j].x, yj = pts[j].y;
      if (((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi)) inside = !inside;
    }
    return inside;
  }

  function toLocal(cx, cy) {
    const r = els.canvasWrap.getBoundingClientRect();
    return { x: (cx - r.left - pan.x) / (zoom * PX_PER_CM), y: (cy - r.top - pan.y) / (zoom * PX_PER_CM) };
  }

  // Snap to existing vertices first, otherwise to the grid.
  function snapPoint(p, excludeIds) {
    const R = 12 / (PX_PER_CM * zoom);
    let best = null, bd = R;
    const consider = (x, y, id) => {
      if (excludeIds && excludeIds.has(id)) return;
      const d = Math.hypot(x - p.x, y - p.y);
      if (d < bd) { bd = d; best = { x, y }; }
    };
    state.walls.forEach(w => { consider(w.x1, w.y1, w.id + ":1"); consider(w.x2, w.y2, w.id + ":2"); });
    state.rooms.forEach(r => r.points.forEach((q, i) => consider(q.x, q.y, r.id + ":" + i)));
    draw.pts.forEach((q, i) => consider(q.x, q.y, "d" + i));
    if (draw.first) consider(draw.first.x, draw.first.y, "df");
    if (best) return { x: best.x, y: best.y, snapped: true };
    return {
      x: Math.round(p.x / SNAP_CM) * SNAP_CM,
      y: Math.round(p.y / SNAP_CM) * SNAP_CM,
      snapped: false,
    };
  }

  // All points (wall ends / room vertices) coincident with (x, y)
  function collectGroup(x, y, includeRooms) {
    const refs = [];
    state.walls.forEach(w => {
      if (near(w.x1, w.y1, x, y)) refs.push({ o: w, kx: "x1", ky: "y1", key: w.id + ":1" });
      if (near(w.x2, w.y2, x, y)) refs.push({ o: w, kx: "x2", ky: "y2", key: w.id + ":2" });
    });
    if (includeRooms !== false) {
      state.rooms.forEach(r => r.points.forEach((p, i) => {
        if (near(p.x, p.y, x, y)) refs.push({ o: p, kx: "x", ky: "y", key: r.id + ":" + i });
      }));
    }
    refs.forEach(r => { r.x0 = r.o[r.kx]; r.y0 = r.o[r.ky]; });
    return refs;
  }
  function mergeRefs(lists) {
    const map = new Map();
    lists.forEach(l => l.forEach(r => { if (!map.has(r.key)) map.set(r.key, r); }));
    return Array.from(map.values());
  }

  // ---------------------------------------------------------------
  // Persistence
  // ---------------------------------------------------------------
  function loadFromStorage() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const parsed = JSON.parse(raw);
      if (parsed && parsed.room && Array.isArray(parsed.items)) { adoptState(parsed); return true; }
    } catch (e) { /* ignore corrupted storage */ }
    return false;
  }
  function saveToStorage() {
    if (viewOnly) return;
    state.view = { x: pan.x, y: pan.y, zoom };
    state.settings = { wallT, partT };
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) { /* unavailable */ }
  }
  let saveTimer = null;
  function scheduleSave() { clearTimeout(saveTimer); saveTimer = setTimeout(saveToStorage, 300); }

  // Accept a state object (also from older versions without rooms/walls)
  function adoptState(s) {
    state = s;
    state.room = state.room || { w: 800, h: 600 };
    state.items = Array.isArray(state.items) ? state.items : [];
    state.walls = Array.isArray(state.walls) ? state.walls : [];
    state.zones = Array.isArray(state.zones) ? state.zones : [];
    state.people = Array.isArray(state.people) ? state.people : [];
    const legacy = !Array.isArray(state.rooms);
    if (legacy) state.rooms = [];
    nextId = computeNextId();
    hasView = !!(state.view && isFinite(state.view.zoom) && isFinite(state.view.x) && isFinite(state.view.y));
    if (hasView) { zoom = clamp(state.view.zoom, 0.15, 4); pan = { x: state.view.x, y: state.view.y }; }
    if (state.settings) { wallT = clamp(+state.settings.wallT || 20, 2, 100); partT = clamp(+state.settings.partT || 8, 2, 100); }
    if (legacy) {
      const W = state.room.w, H = state.room.h;
      const room = makeRoom([{ x: 0, y: 0 }, { x: W, y: 0 }, { x: W, y: H }, { x: 0, y: H }], "Комната 1");
      state.rooms.push(room);
      buildWallsForRoom(room, true);
    }
  }

  function makeRoom(points, name) {
    return { id: "room-" + (nextId++), name: name || ("Комната " + (state.rooms.length + 1)), points: points.map(p => ({ x: p.x, y: p.y })) };
