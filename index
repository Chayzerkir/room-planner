      case "sofa": {
        const arm = Math.min(18, w*0.12);
        return `<rect x="0" y="0" width="${w}" height="${h}" rx="8" fill="${color}" stroke="${dk}" stroke-width="1.4"/>
                <rect x="0" y="0" width="${w}" height="${h*0.28}" rx="6" fill="${dk}"/>
                <rect x="0" y="0" width="${arm}" height="${h}" rx="6" fill="${dk}" opacity="0.9"/>
                <rect x="${w-arm}" y="0" width="${arm}" height="${h}" rx="6" fill="${dk}" opacity="0.9"/>
                <line x1="${w*0.37}" y1="${h*0.32}" x2="${w*0.37}" y2="${h-4}" stroke="${dk}" stroke-width="1" opacity="0.6"/>
                <line x1="${w*0.63}" y1="${h*0.32}" x2="${w*0.63}" y2="${h-4}" stroke="${dk}" stroke-width="1" opacity="0.6"/>`;
      }
      case "armchair": {
        const arm = Math.min(14, w*0.17);
        return `<rect x="0" y="0" width="${w}" height="${h}" rx="10" fill="${color}" stroke="${dk}" stroke-width="1.4"/>
                <rect x="0" y="0" width="${w}" height="${h*0.3}" rx="8" fill="${dk}"/>
                <rect x="0" y="0" width="${arm}" height="${h}" rx="8" fill="${dk}" opacity="0.9"/>
                <rect x="${w-arm}" y="0" width="${arm}" height="${h}" rx="8" fill="${dk}" opacity="0.9"/>`;
      }
      case "cabinet":
        return `<rect x="0" y="0" width="${w}" height="${h}" rx="3" fill="${color}" stroke="${dk}" stroke-width="1.4"/>
                <line x1="${w/2}" y1="2" x2="${w/2}" y2="${h-2}" stroke="${dk}" stroke-width="1"/>
                <circle cx="${w/2-6}" cy="${h/2}" r="2" fill="${dk}"/>
