      roomCards.push(card(`<svg width="44" height="44" viewBox="0 0 44 44"><circle cx="22" cy="22" r="15" fill="rgba(47,95,168,0.14)" stroke="#2f5fa8" stroke-width="2" stroke-dasharray="5 3"/></svg>`,
        "Круглая зона Ø3 м", "радиус можно менять", () => addZoneAtCenter(150)));
    }
    if (roomCards.length) section("Помещения", roomCards);

    const peopleCards = [];
    if (!f || "новый человек люди".indexOf(f) >= 0) {
      peopleCards.push(card(`<svg width="44" height="44" viewBox="0 0 44 44"><circle cx="22" cy="22" r="16" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="4 3"/><path d="M22 14v16M14 22h16" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round"/></svg>`,
        "Новый человек", "затем посадите за стол", () => { const p = addPerson(); if (tool !== "select") setTool("select"); selectItem(p.id); }));
    }
    state.people.filter(p => match(p.name)).forEach(p => {
      const seat = seatOf(p.id);
      peopleCards.push(card(avatarSvg(p, 44), escapeHtml(p.name), seat ? "место " + escapeHtml(seat.name) : "не посажен", () => { if (tool !== "select") setTool("select"); selectItem(p.id); }));
    });
    if (peopleCards.length) section("Люди", peopleCards);

    CATALOG.forEach(group => {
      const items = group.items.filter(s => match(s.name));
      if (!items.length) return;
      section(group.group, items.map(spec => {
        const dimLabel = spec.seats ? `${spec.w}×${spec.h} см · с местами` : `${spec.w}×${spec.h} см`;
        return card(miniIcon(spec), spec.name, dimLabel, () => addItem(spec));
      }));
