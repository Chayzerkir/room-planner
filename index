      const btn = document.createElement("div");
      btn.className = "palette-item";
      btn.innerHTML = `${iconHtml}<div class="pname">${name}</div><div class="pdim">${dim}</div>`;
      btn.addEventListener("click", onClick);
      return btn;
    };

    const roomCards = [];
    [{ name: "Комната 4×3 м", w: 400, h: 300 }, { name: "Комната 6×4 м", w: 600, h: 400 }].forEach(spec => {
      if (!match(spec.name)) return;
      roomCards.push(card(`<svg width="44" height="44" viewBox="0 0 44 44"><rect x="6" y="9" width="32" height="26" fill="rgba(47,95,168,0.12)" stroke="currentColor" stroke-width="4" style="color:var(--wall)"/></svg>`,
        spec.name, "со стенами", () => addRectRoom(spec.w, spec.h)));
    });
