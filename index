    let title = "", sub = "", notes = [];
    if (kind === "item") {
      if (obj.type === "seat") {
        const p = obj.personId ? getPerson(obj.personId) : null;
        title = p ? p.name : "Место " + obj.name;
        sub = (p && p.role ? p.role + " · " : "") + seatLabel(obj);
        if (p && p.comment) notes.push(p.comment);
      } else { title = obj.name; sub = Math.round(obj.w) + "×" + Math.round(obj.h) + " см"; }
    } else if (kind === "room") { title = obj.name; sub = (polyArea(obj.points) / 10000).toFixed(1) + " м²"; }
    else if (kind === "zone") { title = obj.name; sub = (Math.PI * obj.r * obj.r / 10000).toFixed(1) + " м²"; }
    else if (kind === "wall") {
      const pk = PIPE_KINDS[obj.kind];
      title = pk ? pk.name : (obj.kind === "wall" ? "Стена" : "Перегородка");
      sub = Math.round(Math.hypot(obj.x2 - obj.x1, obj.y2 - obj.y1)) + " см · толщина " + obj.t + " см";
    } else if (kind === "person") { title = obj.name; sub = obj.role || ""; }
    if (obj.comment) notes.unshift(obj.comment);
    return `<b>${escapeHtml(title)}</b>` + (sub ? `<div class="tip-sub">${escapeHtml(sub)}</div>` : "") +
