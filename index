  // ---------------------------------------------------------------
  // View mode & sharing (the plan travels inside the link after #)
  // ---------------------------------------------------------------
  function b64urlEncode(bytes) {
    let bin = "";
    for (let i = 0; i < bytes.length; i += 0x8000) bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
    return btoa(bin).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  }
  function b64urlDecode(str) {
    const b = atob(str.replace(/-/g, "+").replace(/_/g, "/") + "===".slice((str.length + 3) % 4));
    const out = new Uint8Array(b.length);
    for (let i = 0; i < b.length; i++) out[i] = b.charCodeAt(i);
    return out;
  }
  async function encodePlan(obj) {
    const bytes = new TextEncoder().encode(JSON.stringify(obj));
    if (typeof CompressionStream !== "undefined") {
      try {
        const stream = new Blob([bytes]).stream().pipeThrough(new CompressionStream("deflate-raw"));
        return "vz" + b64urlEncode(new Uint8Array(await new Response(stream).arrayBuffer()));
      } catch (e) { /* fall back to raw */ }
    }
    return "vr" + b64urlEncode(bytes);
  }
  async function decodePlan(flag, data) {
    let bytes = b64urlDecode(data);
    if (flag === "z") {
      const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream("deflate-raw"));
      bytes = new Uint8Array(await new Response(stream).arrayBuffer());
    }
    return JSON.parse(new TextDecoder().decode(bytes));
  }
  function parseHash() {
    const m = /^#v([zr])([A-Za-z0-9_-]+)$/.exec(location.hash || "");
    return m ? { flag: m[1], data: m[2] } : null;
  }
  function shareSnapshot() {
