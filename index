    body.innerHTML = `
      <div class="props-name"><input type="text" id="propName" value="${escapeAttr(data.name)}"></div>
      <div class="prop-row"><label>Ширина, см</label><input type="number" id="propW" min="5" max="1000" value="${Math.round(data.w)}"></div>
      <div class="prop-row"><label>Глубина, см</label><input type="number" id="propH" min="5" max="1000" value="${Math.round(data.h)}"></div>
      <div class="prop-row"><label>Поворот, °</label><input type="number" id="propRot" min="0" max="359" value="${Math.round(data.rot)}"></div>
      ${seatRow}${personRow}
      <button class="full-btn danger" id="propDelete">Удалить объект</button>
    `;

    document.getElementById("propName").addEventListener("input", (e) => {
      data.name = e.target.value;
      itemEls.get(data.id).querySelector(".item-label").textContent = data.name;
      scheduleSave();
    });
    document.getElementById("propW").addEventListener("change", (e) => {
      data.w = clamp(parseFloat(e.target.value) || data.w, 5, 1000);
      if (data.shape === "ellipse") data.h = data.w;
      refreshIcon(data);
      applyTransform(itemEls.get(data.id), data);
      layoutChildSeats(data);
      scheduleSave();
    });
    document.getElementById("propH").addEventListener("change", (e) => {
      data.h = clamp(parseFloat(e.target.value) || data.h, 5, 1000);
      if (data.shape === "ellipse") data.w = data.h;
      refreshIcon(data);
      applyTransform(itemEls.get(data.id), data);
      layoutChildSeats(data);
      scheduleSave();
    });
    document.getElementById("propRot").addEventListener("change", (e) => {
      let v = parseFloat(e.target.value);
      if (isNaN(v)) v = data.rot;
      data.rot = ((v % 360) + 360) % 360;
      applyTransform(itemEls.get(data.id), data);
      layoutChildSeats(data);
      scheduleSave();
    });
    document.getElementById("propDelete").addEventListener("click", () => deleteItem(data.id));
    if (data.type === "seat") bindSeatPerson(data);

    const seatsInput = document.getElementById("propSeats");
    if (seatsInput) {
      seatsInput.addEventListener("change", (e) => {
        const n = parseInt(e.target.value, 10) || getChildSeats(data.id).length;
        syncSeatsForTable(data, n);
        renderProps();
        scheduleSave();
      });
    }
  }

  function renderRoomProps(room) {
    const body = els.propsBody;
    if (!room) { body.innerHTML = ""; return; }
    const area = (polyArea(room.points) / 10000).toFixed(2);
    const per = (polyPerimeter(room.points) / 100).toFixed(2);
    const rwalls = wallsOfRoom(room);
    const missing = room.points.length - rwalls.length;
    const curT = rwalls.length ? rwalls[0].t : wallT;
    body.innerHTML = `
      <div class="props-name"><input type="text" id="rName" value="${escapeAttr(room.name)}"></div>
      <div class="stat"><span>Площадь</span><b>${area} м²</b></div>
      <div class="stat"><span>Периметр</span><b>${per} м</b></div>
      <div class="stat"><span>Вершин</span><b>${room.points.length}</b></div>
      <div class="prop-row"><label>Толщина стен, см</label><input type="number" id="rT" min="2" max="100" step="2" value="${curT}"></div>
      <button class="full-btn" id="rWalls">Построить стены по контуру${missing > 0 && missing < room.points.length ? " (" + missing + ")" : ""}</button>
      <button class="full-btn danger" id="rDel">Удалить комнату</button>
      <button class="full-btn danger" id="rDelAll">Удалить со стенами</button>
    `;
    document.getElementById("rName").addEventListener("input", (e) => { room.name = e.target.value; renderGeo(); scheduleSave(); });
    document.getElementById("rT").addEventListener("change", (e) => {
      const v = clamp(parseFloat(e.target.value) || 0, 2, 100);
      if (!v) return;
      wallT = v;
      wallsOfRoom(room).forEach(w => { w.t = v; });
      renderGeo(); renderOverlay(); scheduleSave();
    });
    document.getElementById("rWalls").addEventListener("click", () => { buildWallsForRoom(room, false); renderProps(); });
    document.getElementById("rDel").addEventListener("click", () => deleteRoom(room.id, false));
    document.getElementById("rDelAll").addEventListener("click", () => deleteRoom(room.id, true));
  }

  function renderWallProps(w) {
    const body = els.propsBody;
    if (!w) { body.innerHTML = ""; return; }
    const len = Math.round(Math.hypot(w.x2 - w.x1, w.y2 - w.y1));
    body.innerHTML = `
      <div class="prop-row"><label>Тип</label>
        <select id="wKind"><option value="wall"${w.kind === "wall" ? " selected" : ""}>Стена</option><option value="partition"${w.kind === "partition" ? " selected" : ""}>Перегородка</option>${Object.keys(PIPE_KINDS).map(k => `<option value="${k}"${w.kind === k ? " selected" : ""}>${PIPE_KINDS[k].name}</option>`).join("")}</select></div>
      <div class="prop-row"><label>Толщина, см</label><input type="number" id="wT" min="2" max="100" value="${w.t}"></div>
      <div class="prop-row"><label>Длина, см</label><input type="number" id="wL" min="1" max="5000" value="${len}"></div>
      <button class="full-btn danger" id="wDel">Удалить</button>
    `;
    document.getElementById("wKind").addEventListener("change", (e) => {
      w.kind = e.target.value;
      w.t = defaultT(w.kind);
      renderGeo(); renderOverlay(); renderProps(); scheduleSave();
    });
    document.getElementById("wT").addEventListener("change", (e) => {
      w.t = clamp(parseFloat(e.target.value) || w.t, 2, 100);
      renderGeo(); renderOverlay(); scheduleSave();
    });
    document.getElementById("wL").addEventListener("change", (e) => {
      const L = clamp(parseFloat(e.target.value) || len, 1, 5000);
      let ux = w.x2 - w.x1, uy = w.y2 - w.y1;
      const cur = Math.hypot(ux, uy);
      if (cur < 0.01) { ux = 1; uy = 0; } else { ux /= cur; uy /= cur; }
      const refs = collectGroup(w.x2, w.y2, true);
      const nx = r1(w.x1 + ux * L), ny = r1(w.y1 + uy * L);
      refs.forEach(r => { r.o[r.kx] = nx; r.o[r.ky] = ny; });
      renderGeo(); renderOverlay(); scheduleSave();
    });
    document.getElementById("wDel").addEventListener("click", () => deleteWall(w.id));
  }

  // ---------------------------------------------------------------
  // Keyboard shortcuts (layout-independent via e.code)
  // ---------------------------------------------------------------
  document.addEventListener("keydown", (e) => {
    const tag = (e.target.tagName || "").toLowerCase();
    if (tag === "input" || tag === "textarea" || tag === "select") return;

    if (viewOnly) return;
    if (e.code === "Space") {
      if (!spaceDown) { spaceDown = true; els.canvasWrap.classList.add("space"); }
      e.preventDefault();
      return;
    }

    if (e.key === "Escape") {
      if (tool !== "select") {
        if (draw.pts.length) { draw.pts = []; draw.first = null; draw.count = 0; renderOverlay(); }
        else setTool("select");
      } else selectItem(null);
      return;
    }
    if (e.key === "Enter" && tool !== "select") { finishDrawing(true); return; }
    if (multi.size > 1 && tool === "select") {
      if (e.key === "Delete" || e.key === "Backspace") { e.preventDefault(); deleteMulti(); }
      else if (e.code === "KeyR") { e.preventDefault(); rotateGroup(e.shiftKey ? 90 : 15); }
      return;
    }
    if (!selectedId || tool !== "select") return;

    if (e.key === "Delete" || e.key === "Backspace") {
      e.preventDefault();
      deleteSelection();
    } else if (e.code === "KeyR" && selKind(selectedId) === "item") {
      const data = getItem(selectedId);
      if (!data) return;
      e.preventDefault();
      data.rot = (data.rot + (e.shiftKey ? 90 : 15)) % 360;
      applyTransform(itemEls.get(data.id), data);
      layoutChildSeats(data);
      renderProps();
      scheduleSave();
    }
  });

  document.addEventListener("keyup", (e) => {
    if (e.code === "Space") { spaceDown = false; els.canvasWrap.classList.remove("space"); }
  });

  // ---------------------------------------------------------------
  // Zoom
  // ---------------------------------------------------------------
  document.getElementById("zoomIn").addEventListener("click", () => { const c = wrapCenter(); zoomAt(1.2, c.x, c.y); });
  document.getElementById("zoomOut").addEventListener("click", () => { const c = wrapCenter(); zoomAt(1 / 1.2, c.x, c.y); });
  document.getElementById("zoomReset").addEventListener("click", () => { const c = wrapCenter(); zoomAt(1 / zoom, c.x, c.y); });
  document.getElementById("btnFit").addEventListener("click", fitView);
  els.canvasWrap.addEventListener("wheel", (e) => {
    e.preventDefault();
    const r = els.canvasWrap.getBoundingClientRect();
    const cx = e.clientX - r.left, cy = e.clientY - r.top;
    const trackpadPan = !e.ctrlKey && !e.metaKey && e.deltaMode === 0 && (e.deltaX !== 0 || Math.abs(e.deltaY) < 40);
    if (trackpadPan) { pan.x -= e.deltaX; pan.y -= e.deltaY; applyView(); return; }
    zoomAt(e.deltaY < 0 ? 1.12 : 1 / 1.12, cx, cy);
  }, { passive: false });

  // ---------------------------------------------------------------
  // Clear furniture
  // ---------------------------------------------------------------
  const confirmOverlay = document.getElementById("confirmOverlay");
  document.getElementById("btnClear").addEventListener("click", () => confirmOverlay.classList.add("show"));
  document.getElementById("confirmCancel").addEventListener("click", () => confirmOverlay.classList.remove("show"));
  document.getElementById("confirmOk").addEventListener("click", () => {
    state.items.slice().filter(it => it.type !== "door" && it.type !== "window").forEach(it => deleteItem(it.id));
    confirmOverlay.classList.remove("show");
    showToast("Мебель удалена, двери и окна остались");
  });

  // ---------------------------------------------------------------
  // Export / Import
  // ---------------------------------------------------------------
  async function exportPlan() {
    state.view = { x: pan.x, y: pan.y, zoom };
    state.settings = { wallT, partT };
    const payload = JSON.stringify(state, null, 2);
    const filename = "room-plan.json";
    try {
      const downloads = await claude.use("downloads");
      if (downloads) { await downloads.save({ filename, data: payload }); showToast("План сохраняется…"); return; }
    } catch (err) {
      if (err && err.code === "declined") return;
    }
    try {
      const blob = new Blob([payload], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); a.remove();
      URL.revokeObjectURL(url);
    } catch (e) { showToast("Не удалось скачать файл"); }
  }
  document.getElementById("btnExport").addEventListener("click", exportPlan);

  document.getElementById("btnImport").addEventListener("click", () => document.getElementById("fileInput").click());
  document.getElementById("fileInput").addEventListener("change", (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const parsed = JSON.parse(reader.result);
        if (!parsed || !Array.isArray(parsed.items)) throw new Error("bad format");
        rebuildFromState(parsed);
        showToast("План загружен");
      } catch (err) { showToast("Не удалось прочитать файл: неверный формат"); }
    };
    reader.readAsText(file);
    e.target.value = "";
  });

  function rebuildFromState(newState) {
    itemEls.forEach(el => el.remove());
    itemEls.clear();
    setToolSilently("select");
    adoptState(newState);
    if (!hasView) fitView(); else applyView();
    renderGeo();
    state.items.forEach(data => mountItem(data));
    selectedId = null;
    renderProps();
    renderOverlay();
    scheduleSave();
  }
  function setToolSilently(t) {
    tool = t; draw = { pts: [], first: null, count: 0, cursor: null };
    els.canvasWrap.classList.remove("drawing");
    updatePipesOn();
    els.tools.querySelectorAll("button").forEach(b => b.classList.toggle("active", b.dataset.tool === t));
    els.drawBar.classList.remove("show");
  }

  // ---------------------------------------------------------------
  // Mobile drawers
  // ---------------------------------------------------------------
  const paletteEl = document.getElementById("palette");
  const propsEl = document.getElementById("props");
  const scrim = document.getElementById("scrim");
  function closeDrawers() { paletteEl.classList.remove("open"); propsEl.classList.remove("open"); scrim.classList.remove("show"); }
  document.getElementById("openPalette").addEventListener("click", () => { paletteEl.classList.add("open"); propsEl.classList.remove("open"); scrim.classList.add("show"); });
  document.getElementById("openProps").addEventListener("click", () => { propsEl.classList.add("open"); paletteEl.classList.remove("open"); scrim.classList.add("show"); });
  scrim.addEventListener("click", closeDrawers);
  paletteEl.addEventListener("click", (e) => { if (e.target.closest(".palette-item") && window.innerWidth <= 860) closeDrawers(); });

  // ---------------------------------------------------------------
  // Init
  // ---------------------------------------------------------------
  function init() {
    const fromLink = !!parseHash();
    if (fromLink) { viewOnly = true; document.body.classList.add("view-only"); }
    buildPalette();
    const restored = fromLink ? false : loadFromStorage();
    if (!restored && !fromLink) {
      state = { room: { w: 800, h: 600 }, rooms: [], walls: [], zones: [], people: [], items: [] };
      nextId = 1;
      seedDefaultRoom();
    }
    renderGeo();
    state.items.forEach(data => mountItem(data));
    if (hasView) applyView(); else fitView();
    renderProps();
    renderOverlay();
    runCheck();
    if (fromLink) loadFromHash();
    if (restored && (state.items.length || state.walls.length)) showToast("План восстановлен из этого браузера");
  }

  init();
})();
</script>
</body>
</html>
