      case "riser":
        return `<ellipse cx="${w/2}" cy="${h/2}" rx="${w/2-0.5}" ry="${h/2-0.5}" fill="${color}" stroke="${dk}" stroke-width="1.2"/><ellipse cx="${w/2}" cy="${h/2}" rx="${w*0.28}" ry="${h*0.28}" fill="${lt}" stroke="${dk}" stroke-width="0.8"/>`;
      case "boiler":
