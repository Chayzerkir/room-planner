  }
  els.palSearch.addEventListener("input", (e) => { palFilter = e.target.value; buildPalette(); });

  // ---------------------------------------------------------------
  // View: infinite canvas (pan + zoom), adaptive grid
  // ---------------------------------------------------------------
  const VB = 1 / PX_PER_CM;
  [els.geo, els.labelsLayer, els.notesLayer, els.issuesLayer, els.overlay].forEach(sv => {
    sv.setAttribute("viewBox", `0 0 ${VB} ${VB}`);
    sv.setAttribute("width", "1"); sv.setAttribute("height", "1");
  });

  function applyView() {
    els.stage.style.transform = `translate(${pan.x}px, ${pan.y}px) scale(${zoom})`;
    const s = PX_PER_CM * zoom, w = els.canvasWrap;
    w.style.setProperty("--g1", (100 * s) + "px");
    w.style.setProperty("--g2", (20 * s) + "px");
    w.style.setProperty("--g3", (10 * s) + "px");
    w.style.setProperty("--gx", pan.x + "px");
    w.style.setProperty("--gy", pan.y + "px");
    w.style.setProperty("--c2", 20 * s >= 6 ? "var(--grid-minor)" : "transparent");
    w.style.setProperty("--c3", 10 * s >= 7 ? "var(--grid-fine)" : "transparent");
    document.getElementById("zoomReset").textContent = Math.round(zoom * 100) + "%";
    renderOverlay();
    renderIssues();
    if (zoom !== lastLabelZoom) { lastLabelZoom = zoom; renderRoomLabels(); renderNotes(); }
    scheduleSave();
  }
  function wrapCenter() { const r = els.canvasWrap.getBoundingClientRect(); return { x: r.width / 2, y: r.height / 2 }; }
  function zoomAt(factor, cx, cy) {
    const nz = clamp(zoom * factor, 0.15, 4);
    const f = nz / zoom;
    pan.x = cx - (cx - pan.x) * f;
    pan.y = cy - (cy - pan.y) * f;
    zoom = nz;
    applyView();
  }
  function contentBounds() {
    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    const ext = (x, y) => { minX = Math.min(minX, x); minY = Math.min(minY, y); maxX = Math.max(maxX, x); maxY = Math.max(maxY, y); };
    state.rooms.forEach(r => r.points.forEach(p => ext(p.x, p.y)));
    state.zones.forEach(z => { ext(z.cx - z.r, z.cy - z.r); ext(z.cx + z.r, z.cy + z.r); });
    state.walls.forEach(w => { ext(w.x1, w.y1); ext(w.x2, w.y2); });
    state.items.forEach(it => { const m = Math.max(it.w, it.h) / 2; ext(it.x - m, it.y - m); ext(it.x + m, it.y + m); });
    return isFinite(minX) ? { minX, minY, maxX, maxY } : null;
  }
  function fitView() {
    let r = els.canvasWrap.getBoundingClientRect();
    if (r.width < 50 || r.height < 50) r = { width: 800, height: 600 };
    const b = contentBounds() || { minX: 0, minY: 0, maxX: 800, maxY: 600 };
    const bw = Math.max(100, b.maxX - b.minX), bh = Math.max(100, b.maxY - b.minY);
    const m = 70;
    zoom = clamp(Math.min((r.width - m * 2) / (bw * PX_PER_CM), (r.height - m * 2) / (bh * PX_PER_CM)), 0.15, 1.5);
    pan.x = r.width / 2 - ((b.minX + b.maxX) / 2) * PX_PER_CM * zoom;
    pan.y = r.height / 2 - ((b.minY + b.maxY) / 2) * PX_PER_CM * zoom;
    hasView = true;
    applyView();
  }
  let panAnim = null;
  function panTo(cx, cy) {
    const r = els.canvasWrap.getBoundingClientRect();
    const tx = r.width / 2 - cx * PX_PER_CM * zoom, ty = r.height / 2 - cy * PX_PER_CM * zoom;
    const sx = pan.x, sy = pan.y, t0 = performance.now(), dur = 280;
    cancelAnimationFrame(panAnim);
    const step = (t) => {
      const p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3);
      pan.x = sx + (tx - sx) * e; pan.y = sy + (ty - sy) * e;
      applyView();
      if (p < 1) panAnim = requestAnimationFrame(step);
    };
    panAnim = requestAnimationFrame(step);
  }
  function startPan(e, clickDeselect, onStill) {
    const sx = e.clientX, sy = e.clientY, px0 = pan.x, py0 = pan.y;
    let moved = false;
    els.canvasWrap.classList.add("panning");
    trackPointer((ev) => {
      const dx = ev.clientX - sx, dy = ev.clientY - sy;
      if (!moved && Math.hypot(dx, dy) < 4) return;
      moved = true; pan.x = px0 + dx; pan.y = py0 + dy; applyView();
    }, () => {
      els.canvasWrap.classList.remove("panning");
      if (!moved && clickDeselect) selectItem(null);
      if (!moved && onStill) onStill();
    });
  }
    function showDimHint(on) { els.dimHint.classList.toggle("show", !!on); }

  // ---------------------------------------------------------------
  // Overlap detection: items vs items, items vs walls
  // ---------------------------------------------------------------
  function itemPoly(it) {
    const th = it.rot * Math.PI / 180, c = Math.cos(th), s = Math.sin(th);
    let local;
    if (it.shape === "ellipse") {
      local = [];
      for (let i = 0; i < 28; i++) { const a = (i / 28) * Math.PI * 2; local.push([Math.cos(a) * it.w / 2, Math.sin(a) * it.h / 2]); }
    } else {
      local = [[-it.w / 2, -it.h / 2], [it.w / 2, -it.h / 2], [it.w / 2, it.h / 2], [-it.w / 2, it.h / 2]];
    }
    return local.map(q => ({ x: it.x + q[0] * c - q[1] * s, y: it.y + q[0] * s + q[1] * c }));
  }
  function wallPoly(w) {
    let ux = w.x2 - w.x1, uy = w.y2 - w.y1;
    const len = Math.hypot(ux, uy);
    if (len < 0.01) { ux = 1; uy = 0; } else { ux /= len; uy /= len; }
    const ext = w.t / 2, h = w.t / 2, nx = -uy, ny = ux;
    const ax = w.x1 - ux * ext, ay = w.y1 - uy * ext, bx = w.x2 + ux * ext, by = w.y2 + uy * ext;
    return [{ x: ax + nx * h, y: ay + ny * h }, { x: bx + nx * h, y: by + ny * h }, { x: bx - nx * h, y: by - ny * h }, { x: ax - nx * h, y: ay - ny * h }];
  }
  function signedArea(p) {
    let s = 0;
    for (let i = 0; i < p.length; i++) { const a = p[i], b = p[(i + 1) % p.length]; s += a.x * b.y - b.x * a.y; }
    return s / 2;
  }
  // Sutherland–Hodgman: both polygons are convex here
  function clipConvex(subject, clip) {
    const cp = signedArea(clip) >= 0 ? clip : clip.slice().reverse();
    let out = subject;
    for (let i = 0; i < cp.length && out.length; i++) {
      const a = cp[i], b = cp[(i + 1) % cp.length];
      const inside = (p) => (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x) >= 0;
      const inter = (p, q) => {
        const x1 = p.x, y1 = p.y, x2 = q.x, y2 = q.y, x3 = a.x, y3 = a.y, x4 = b.x, y4 = b.y;
        const den = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4);
        if (Math.abs(den) < 1e-9) return { x: q.x, y: q.y };
        const t = ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) / den;
        return { x: x1 + t * (x2 - x1), y: y1 + t * (y2 - y1) };
      };
      const input = out; out = [];
      for (let j = 0; j < input.length; j++) {
        const P = input[j], Q = input[(j + 1) % input.length];
        const pin = inside(P), qin = inside(Q);
        if (pin && qin) out.push(Q);
        else if (pin && !qin) out.push(inter(P, Q));
        else if (!pin && qin) { out.push(inter(P, Q)); out.push(Q); }
      }
    }
    return out;
  }
  function bboxOf(poly) {
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    poly.forEach(p => { x0 = Math.min(x0, p.x); y0 = Math.min(y0, p.y); x1 = Math.max(x1, p.x); y1 = Math.max(y1, p.y); });
    return { x0, y0, x1, y1 };
  }
  function bboxHit(a, b) { return a.x0 < b.x1 && a.x1 > b.x0 && a.y0 < b.y1 && a.y1 > b.y0; }

  function itemLabel(it) {
    if (it.type === "seat") {
      const par = it.parentId ? getItem(it.parentId) : null;
      return "место «" + it.name + "»" + (par ? " у «" + par.name + "»" : "");
    }
    return "«" + it.name + "»";
  }
  function cap(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

  let checkQueued = false;
  function requestCheck() {
    if (checkQueued) return;
    checkQueued = true;
    (window.requestAnimationFrame || setTimeout)(() => { checkQueued = false; runCheck(); });
  }

  function runCheck() {
    const res = [];
    const its = state.items.map(it => { const poly = itemPoly(it); return { it, poly, bb: bboxOf(poly) }; });
    const ws = state.walls.filter(w => !PIPE_KINDS[w.kind]).map(w => { const poly = wallPoly(w); return { w, poly, bb: bboxOf(poly) }; });

    state.zones.forEach(z => {
      if (!(z.wallT > 0)) return;
      const n = 32;
      for (let i = 0; i < n; i++) {
        const a1 = (i / n) * Math.PI * 2, a2 = ((i + 1) / n) * Math.PI * 2;
        const w = { id: z.id, kind: "wall", t: z.wallT, x1: z.cx + Math.cos(a1) * z.r, y1: z.cy + Math.sin(a1) * z.r, x2: z.cx + Math.cos(a2) * z.r, y2: z.cy + Math.sin(a2) * z.r };
        const poly = wallPoly(w);
        ws.push({ w, poly, bb: bboxOf(poly) });
      }
    });
    const seenKeys = new Set();
    const push = (key, a, b, text) => {
      if (seenKeys.has(key)) return;
      const poly = clipConvex(a.poly, b.poly);
      if (poly.length < 3) return;
      const area = Math.abs(signedArea(poly));
      if (area < 2) return;
      seenKeys.add(key);
      const c = polyCentroid(poly);
      res.push({ key, poly, area, cx: c.x, cy: c.y, text });
    };

    for (let i = 0; i < its.length; i++) {
      const fi = TYPE_FLAGS[its[i].it.type] || {};
      for (let j = i + 1; j < its.length; j++) {
        const fj = TYPE_FLAGS[its[j].it.type] || {};
        if (skipChk(fi) || skipChk(fj)) continue;
        if (!bboxHit(its[i].bb, its[j].bb)) continue;
        push(its[i].it.id + "|" + its[j].it.id, its[i], its[j],
          cap(itemLabel(its[i].it)) + " пересекается с " + itemLabel(its[j].it));
      }
      if (skipChk(fi) || fi.onWall) continue;   // rugs lie under things; doors, windows and wall-mounted items belong in walls
      for (let j = 0; j < ws.length; j++) {
        if (!bboxHit(its[i].bb, ws[j].bb)) continue;
        push(its[i].it.id + "|" + ws[j].w.id, its[i], ws[j],
          cap(itemLabel(its[i].it)) + " заходит на " + (ws[j].w.kind === "wall" ? "стену" : "перегородку"));
      }
    }
    issues = res.slice(0, 200);
    renderIssues();
    renderIssuesPanel();
    renderRoomLabels();
    renderNotes();
  }

  function renderIssues() {
    const k = 1 / (PX_PER_CM * zoom);
    let s = "";
    issues.forEach(is => {
      let rad = 0;
      is.poly.forEach(p => { rad = Math.max(rad, Math.hypot(p.x - is.cx, p.y - is.cy)); });
      rad = Math.max(rad + 5 * k, 12 * k);
      s += `<g class="issue${is.key === flashKey ? " flash" : ""}"><polygon points="${is.poly.map(p => `${r1(p.x)},${r1(p.y)}`).join(" ")}" style="fill:var(--bad);fill-opacity:.42;stroke:var(--bad);stroke-width:2;vector-effect:non-scaling-stroke;stroke-linejoin:round"/><circle cx="${r1(is.cx)}" cy="${r1(is.cy)}" r="${r1(rad)}" style="fill:none;stroke:var(--bad);stroke-width:1.5;stroke-dasharray:4 3;vector-effect:non-scaling-stroke"/></g>`;
    });
    els.issuesLayer.innerHTML = s;
  }

  let labelSigLocal = "";
  function renderRoomLabels() {
    const k = 1 / (PX_PER_CM * zoom);
    const fs = Math.max(18 / PX_PER_CM, 13 * k);              // larger text, never below ~13 screen px
    const prep = (poly) => ({ poly, bb: bboxOf(poly) });
    const itemShapes = state.items.filter(it => !skipChk(TYPE_FLAGS[it.type])).map(it => prep(itemPoly(it)));
    const wallShapes = state.walls.map(w => prep(wallPoly(w)));
    const hits = (rect, shapes) => {
      const bb = bboxOf(rect);
      for (const sh of shapes) {
        if (!bboxHit(bb, sh.bb)) continue;
        const c = clipConvex(sh.poly, rect);
        if (c.length >= 3 && Math.abs(signedArea(c)) > 1) return true;
      }
      return false;
    };
    const halo = `paint-order:stroke;stroke:var(--bg-canvas);stroke-width:${3 * k}px;stroke-linejoin:round;`;
    let s = "";
    const shapes = state.rooms.map(r => ({ id: r.id, name: r.name, points: r.points, a: polyArea(r.points) }))
      .concat(state.zones.map(z => ({ id: z.id, name: z.name, points: zonePoly(z), a: Math.PI * z.r * z.r })));
    shapes.forEach(r => {
      if (r.points.length < 3) return;
      const kindAttr = `data-kind="${r.id.indexOf("zone-") === 0 ? "zone" : "room"}" data-id="${r.id}"`;
      const area = (r.a / 10000).toFixed(1) + " м²";
      const bw = Math.max(r.name.length, area.length) * fs * 0.6 + fs * 1.4, bh = fs * 2.6;
      const rectAt = (cx, cy) => [{ x: cx - bw / 2, y: cy - bh / 2 }, { x: cx + bw / 2, y: cy - bh / 2 }, { x: cx + bw / 2, y: cy + bh / 2 }, { x: cx - bw / 2, y: cy + bh / 2 }];
      const c = polyCentroid(r.points);
      let pos = { x: c.x, y: c.y }, boxed = false;
      if (hits(rectAt(c.x, c.y), itemShapes)) {                // something stands on the label → move it to a corner
        boxed = true;
        const margin = 26;
        const cands = r.points.map(v => {
          const sx = Math.sign(c.x - v.x) || 1, sy = Math.sign(c.y - v.y) || 1;
          return { x: v.x + sx * (bw / 2 + margin), y: v.y + sy * (bh / 2 + margin) };
        }).sort((a, b) => (a.x + a.y) - (b.x + b.y));
        let found = null;
        for (const cd of cands) {
          const rect = rectAt(cd.x, cd.y);
          if (!rect.every(p => pointInPoly(p.x, p.y, r.points))) continue;
          if (hits(rect, itemShapes) || hits(rect, wallShapes)) continue;
          found = cd; break;
        }
        pos = found || cands[0];
      }
      if (boxed) {
        s += `<rect ${kindAttr} x="${r1(pos.x - bw / 2)}" y="${r1(pos.y - bh / 2)}" width="${r1(bw)}" height="${r1(bh)}" rx="${r1(fs * 0.3)}" style="fill:var(--bg-panel);fill-opacity:.95;stroke:var(--accent);stroke-width:1.5;vector-effect:non-scaling-stroke;pointer-events:all;cursor:pointer;touch-action:none"/>`;
      }
      const y1 = pos.y - bh / 2 + fs * 1.15, y2 = y1 + fs * 1.05;
      const h = boxed ? "" : halo;
      s += `<text ${kindAttr} x="${r1(pos.x)}" y="${r1(y1)}" text-anchor="middle" style="pointer-events:all;cursor:pointer;touch-action:none;font-size:${r1(fs)}px;fill:var(--ink);font-weight:600;${h}font-family:Inter,sans-serif">${escapeHtml(r.name)}</text>`;
      s += `<text ${kindAttr} x="${r1(pos.x)}" y="${r1(y2)}" text-anchor="middle" style="pointer-events:all;cursor:pointer;touch-action:none;font-size:${r1(fs * 0.85)}px;fill:var(--ink-muted);${h}font-family:Inter,sans-serif">${area}</text>`;
    });
    if (s === labelSig) return;
    labelSig = s;
    els.labelsLayer.innerHTML = s;
  }

  let issuesSig = "";
  function renderIssuesPanel(force) {
    const sig = issues.map(i => i.key + ":" + Math.round(i.area)).join("|") + (issuesOpen ? "1" : "0");
    if (!force && sig === issuesSig) return;
    issuesSig = sig;
    if (!issues.length) {
      els.issuesPill.className = "issues-pill ok";
      els.issuesPill.textContent = "✓ Наложений нет";
      els.issuesList.innerHTML = "";
      els.issues.classList.remove("open");
      return;
    }
    els.issuesPill.className = "issues-pill bad";
    els.issuesPill.textContent = "⚠ Замечаний: " + issues.length + (issuesOpen ? " ▾" : " ▴");
    const shown = issues.slice(0, 100);
    els.issuesList.innerHTML = shown.map(i =>
      `<button class="issue-row" data-key="${escapeAttr(i.key)}">${escapeHtml(i.text)}<small>наложение ≈ ${Math.round(i.area)} см² · нажмите, чтобы перейти</small></button>`
    ).join("") + (issues.length > shown.length ? `<div class="issue-row"><small>…и ещё ${issues.length - shown.length}</small></div>` : "");
    els.issues.classList.toggle("open", issuesOpen);
  }
  els.issuesPill.addEventListener("click", () => { issuesOpen = !issuesOpen; renderIssuesPanel(true); });
  els.issuesList.addEventListener("click", (e) => {
    const b = e.target.closest(".issue-row[data-key]");
    if (!b) return;
    const is = issues.find(i => i.key === b.dataset.key);
    if (!is) return;
    flashKey = is.key;
    clearTimeout(flashTimer);
    flashTimer = setTimeout(() => { flashKey = null; renderIssues(); }, 2400);
    panTo(is.cx, is.cy);
  });

  // ---------------------------------------------------------------
  // Geometry rendering: floors, walls (below furniture)
  // ---------------------------------------------------------------
  function renderGeo() {
    let s = "";
    state.rooms.forEach(r => {
      const pts = r.points.map(p => `${r1(p.x)},${r1(p.y)}`).join(" ");
      s += `<polygon points="${pts}" style="fill:var(--floor);stroke:var(--room-line);stroke-width:1.5;vector-effect:non-scaling-stroke;pointer-events:none"/>`;
    });
    state.zones.forEach(z => {
      s += `<circle cx="${r1(z.cx)}" cy="${r1(z.cy)}" r="${r1(z.r)}" style="fill:${z.color};fill-opacity:.16;stroke:${z.color};stroke-opacity:.75;stroke-width:1.5;vector-effect:non-scaling-stroke;stroke-dasharray:7 4;pointer-events:none"/>`;
      if (z.wallT > 0) s += `<circle cx="${r1(z.cx)}" cy="${r1(z.cy)}" r="${r1(z.r)}" style="fill:none;stroke:var(--wall);stroke-width:${z.wallT};pointer-events:none"/>`;
    });
    state.rooms.forEach(r => {      // edge hit areas: the floor itself stays free for rubber-band selection
      const pts = r.points.map(p => `${r1(p.x)},${r1(p.y)}`).join(" ");
      s += `<polygon data-kind="room" data-id="${r.id}" points="${pts}" style="fill:none;stroke:transparent;stroke-width:14;vector-effect:non-scaling-stroke;pointer-events:stroke;touch-action:none;cursor:pointer"/>`;
    });
    state.zones.forEach(z => {
      s += `<circle data-kind="zone" data-id="${z.id}" cx="${r1(z.cx)}" cy="${r1(z.cy)}" r="${r1(z.r)}" style="fill:none;stroke:transparent;stroke-width:14;vector-effect:non-scaling-stroke;pointer-events:stroke;touch-action:none;cursor:pointer"/>`;
    });
    state.walls.forEach(w => {
      const pk = PIPE_KINDS[w.kind];
      const col = pk ? pk.color : (w.kind === "wall" ? "var(--wall)" : "var(--partition)");
      s += `<line${pk ? ' class="pipe-line"' : ""} x1="${r1(w.x1)}" y1="${r1(w.y1)}" x2="${r1(w.x2)}" y2="${r1(w.y2)}" style="stroke:${col};stroke-width:${w.t};stroke-linecap:${pk ? "round" : "square"};${pk && pk.dash ? "stroke-dasharray:" + pk.dash + ";" : ""}pointer-events:none"/>`;
    });
    state.walls.forEach(w => {
      s += `<line data-kind="wall" data-id="${w.id}" x1="${r1(w.x1)}" y1="${r1(w.y1)}" x2="${r1(w.x2)}" y2="${r1(w.y2)}" style="stroke:transparent;stroke-width:${Math.max(w.t, 12)};stroke-linecap:butt;pointer-events:stroke;touch-action:none;cursor:pointer"/>`;
    });
    els.geo.innerHTML = s;
    updatePipesOn();
    requestCheck();
  }

  // ---------------------------------------------------------------
  // Overlay: selection handles, dimensions, drawing preview (above furniture)
  // ---------------------------------------------------------------
  function renderOverlay() {
    const k = 1 / (PX_PER_CM * zoom);        // cm per screen pixel
    const hr = (coarse ? 10 : 7) * k;
    const fs = 12 * k;
    const halo = `paint-order:stroke;stroke:var(--bg-canvas);stroke-width:${3 * k}px;stroke-linejoin:round;`;
    const label = (x, y, text, eq) =>
      `<text x="${r1(x)}" y="${r1(y)}" text-anchor="middle" dominant-baseline="middle" style="font-size:${fs}px;fill:${eq ? "var(--accent)" : "var(--ink)"};${halo}pointer-events:none;font-family:Inter,sans-serif;font-weight:600">${text}</text>`;
    const handleStyle = "fill:var(--accent);stroke:var(--accent-contrast);stroke-width:2;vector-effect:non-scaling-stroke;pointer-events:all;cursor:grab;touch-action:none";
    let s = "";

    if (tool === "select") {
      const kind = selKind(selectedId);
      if (kind === "room") {
        const r = getRoom(selectedId);
        if (r) {
          const n = r.points.length;
          s += `<polygon points="${r.points.map(p => `${r1(p.x)},${r1(p.y)}`).join(" ")}" style="fill:none;stroke:var(--accent);stroke-width:2;vector-effect:non-scaling-stroke;pointer-events:none"/>`;
          for (let i = 0; i < n; i++) {
            const a = r.points[i], b = r.points[(i + 1) % n];
            const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
            const len = Math.hypot(b.x - a.x, b.y - a.y);
            const ang = Math.atan2(b.y - a.y, b.x - a.x);
            if (!dragDims) s += label(mx + Math.sin(ang) * 20 * k, my - Math.cos(ang) * 20 * k, Math.round(len));
            s += `<circle data-h="rm" data-i="${i}" cx="${r1(mx)}" cy="${r1(my)}" r="${hr * 0.72}" style="fill:var(--bg-panel);stroke:var(--accent);stroke-width:2;vector-effect:non-scaling-stroke;pointer-events:all;cursor:copy;touch-action:none"/>`;
          }
          r.points.forEach((p, i) => {
            s += `<circle data-h="rv" data-i="${i}" cx="${r1(p.x)}" cy="${r1(p.y)}" r="${hr}" style="${handleStyle}"/>`;
          });
        }
      } else if (kind === "wall") {
        const w = getWall(selectedId);
        if (w) {
          s += `<line x1="${r1(w.x1)}" y1="${r1(w.y1)}" x2="${r1(w.x2)}" y2="${r1(w.y2)}" style="stroke:var(--accent);stroke-opacity:.35;stroke-width:${w.t + 8 * k};stroke-linecap:square;pointer-events:none"/>`;
          const len = Math.hypot(w.x2 - w.x1, w.y2 - w.y1);
          const ang = Math.atan2(w.y2 - w.y1, w.x2 - w.x1);
          const off = w.t / 2 + 16 * k;
          if (!dragDims) s += label((w.x1 + w.x2) / 2 + Math.sin(ang) * off, (w.y1 + w.y2) / 2 - Math.cos(ang) * off, Math.round(len));
          s += `<circle data-h="we" data-i="1" cx="${r1(w.x1)}" cy="${r1(w.y1)}" r="${hr}" style="${handleStyle}"/>`;
          s += `<circle data-h="we" data-i="2" cx="${r1(w.x2)}" cy="${r1(w.y2)}" r="${hr}" style="${handleStyle}"/>`;
        }
      } else if (kind === "zone") {
        const z = getZone(selectedId);
        if (z) {
          s += `<circle cx="${r1(z.cx)}" cy="${r1(z.cy)}" r="${r1(z.r)}" style="fill:none;stroke:var(--accent);stroke-width:2;vector-effect:non-scaling-stroke;pointer-events:none"/>`;
          s += `<line x1="${r1(z.cx)}" y1="${r1(z.cy)}" x2="${r1(z.cx + z.r)}" y2="${r1(z.cy)}" style="stroke:var(--accent);stroke-width:1.2;vector-effect:non-scaling-stroke;stroke-dasharray:4 3;pointer-events:none"/>`;
          s += label(z.cx + z.r / 2, z.cy - 14 * k, "R " + Math.round(z.r));
          s += `<circle data-h="zr" cx="${r1(z.cx + z.r)}" cy="${r1(z.cy)}" r="${hr}" style="${handleStyle};cursor:ew-resize"/>`;
        }
      }
    } else {
      const c = draw.cursor;
      if (tool === "room") {
        const pts = draw.pts;
        const all = c ? pts.concat([c]) : pts;
        if (all.length >= 2) {
          s += `<polygon points="${all.map(p => `${r1(p.x)},${r1(p.y)}`).join(" ")}" style="fill:var(--accent);fill-opacity:.1;stroke:var(--accent);stroke-width:2;vector-effect:non-scaling-stroke;stroke-dasharray:6 4;pointer-events:none"/>`;
        }
        if (pts.length && c) {
          const last = pts[pts.length - 1];
          s += label((last.x + c.x) / 2, (last.y + c.y) / 2 - 14 * k, Math.round(Math.hypot(c.x - last.x, c.y - last.y)));
        }
        pts.forEach((p, i) => {
          const isFirst = i === 0 && pts.length >= 3;
          s += `<circle cx="${r1(p.x)}" cy="${r1(p.y)}" r="${isFirst ? hr * 1.25 : hr * 0.8}" style="fill:${isFirst ? "var(--bg-panel)" : "var(--accent)"};stroke:var(--accent);stroke-width:2;vector-effect:non-scaling-stroke;pointer-events:none"/>`;
        });
      } else if (tool === "zone") {
        const zz = draw.zone;
        if (zz) {
          s += `<circle cx="${r1(zz.cx)}" cy="${r1(zz.cy)}" r="${r1(Math.max(zz.r, 1))}" style="fill:var(--accent);fill-opacity:.12;stroke:var(--accent);stroke-width:2;vector-effect:non-scaling-stroke;stroke-dasharray:6 4;pointer-events:none"/>`;
          s += `<line x1="${r1(zz.cx)}" y1="${r1(zz.cy)}" x2="${r1(zz.cx + zz.r)}" y2="${r1(zz.cy)}" style="stroke:var(--accent);stroke-width:1.2;vector-effect:non-scaling-stroke;pointer-events:none"/>`;
          s += label(zz.cx + zz.r / 2, zz.cy - 14 * k, "R " + Math.round(zz.r));
        }
      } else {
        const t = defaultT(drawKind());
        const last = draw.pts[0];
        if (last && c) {
          s += `<line x1="${r1(last.x)}" y1="${r1(last.y)}" x2="${r1(c.x)}" y2="${r1(c.y)}" style="stroke:var(--accent);stroke-opacity:.55;stroke-width:${t};stroke-linecap:square;pointer-events:none"/>`;
          const len = Math.hypot(c.x - last.x, c.y - last.y);
          const ang = Math.atan2(c.y - last.y, c.x - last.x);
          s += label((last.x + c.x) / 2 + Math.sin(ang) * (t / 2 + 16 * k), (last.y + c.y) / 2 - Math.cos(ang) * (t / 2 + 16 * k), Math.round(len));
        }
        if (last) s += `<circle cx="${r1(last.x)}" cy="${r1(last.y)}" r="${hr * 0.8}" style="fill:var(--accent);stroke:var(--accent-contrast);stroke-width:2;vector-effect:non-scaling-stroke;pointer-events:none"/>`;
      }
      if (c) {
        s += `<circle cx="${r1(c.x)}" cy="${r1(c.y)}" r="${hr * 0.9}" style="fill:${c.snapped ? "var(--accent)" : "none"};fill-opacity:.35;stroke:var(--accent);stroke-width:1.5;vector-effect:non-scaling-stroke;pointer-events:none"/>`;
      }
    }
    if (dragDims) {
      const segs = [];
      state.walls.forEach(w => { if (!PIPE_KINDS[w.kind]) segs.push({ x1: w.x1, y1: w.y1, x2: w.x2, y2: w.y2, off: w.t / 2 }); });
      state.rooms.forEach(r => {
        const n = r.points.length;
        for (let i = 0; i < n; i++) {
          const a = r.points[i], b = r.points[(i + 1) % n];
          if (!wallOnEdge(a, b)) segs.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y, off: 0 });
        }
      });
      const counts = {};
      segs.forEach(g => { g.len = Math.round(Math.hypot(g.x2 - g.x1, g.y2 - g.y1)); counts[g.len] = (counts[g.len] || 0) + 1; });
      segs.forEach(g => {
        const mx = (g.x1 + g.x2) / 2, my = (g.y1 + g.y2) / 2, ang = Math.atan2(g.y2 - g.y1, g.x2 - g.x1);
        const nx = Math.sin(ang), ny = -Math.cos(ang), off = g.off + 14 * k;
        let px = mx + nx * off, py = my + ny * off;
        if (state.rooms.some(r => pointInPoly(px, py, r.points))) { px = mx - nx * off; py = my - ny * off; }
        s += label(px, py, g.len, counts[g.len] > 1);
      });
    }
    els.overlay.innerHTML = s;
  }

  function escapeHtml(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
  function escapeAttr(s) { return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;"); }

  // ---------------------------------------------------------------
  // Walls & rooms: operations
  // ---------------------------------------------------------------
  function addWall(a, b, kind) {
    const w = { id: "wall-" + (nextId++), kind, x1: r1(a.x), y1: r1(a.y), x2: r1(b.x), y2: r1(b.y), t: defaultT(kind) };
    state.walls.push(w);
    return w;
  }
  function wallOnEdge(a, b) {
    return state.walls.find(w => !PIPE_KINDS[w.kind] &&
      (near(w.x1, w.y1, a.x, a.y) && near(w.x2, w.y2, b.x, b.y)) ||
      (near(w.x1, w.y1, b.x, b.y) && near(w.x2, w.y2, a.x, a.y)));
  }
  function buildWallsForRoom(room, silent) {
    let added = 0;
    const n = room.points.length;
    for (let i = 0; i < n; i++) {
      const a = room.points[i], b = room.points[(i + 1) % n];
      if (!wallOnEdge(a, b)) { addWall(a, b, "wall"); added++; }
    }
    if (!silent) { renderGeo(); renderOverlay(); scheduleSave(); showToast(added ? `Добавлено стен: ${added}` : "Стены по контуру уже есть"); }
  }
  function wallsOfRoom(room) {
    const n = room.points.length, res = [];
    for (let i = 0; i < n; i++) { const w = wallOnEdge(room.points[i], room.points[(i + 1) % n]); if (w && res.indexOf(w) < 0) res.push(w); }
    return res;
  }
  function deleteRoom(id, withWalls) {
    const r = getRoom(id);
    if (!r) return;
    if (withWalls) { const ws = wallsOfRoom(r); state.walls = state.walls.filter(w => ws.indexOf(w) < 0); }
    state.rooms = state.rooms.filter(x => x.id !== id);
    if (selectedId === id) selectItem(null);
    renderGeo(); renderOverlay(); scheduleSave();
  }
  function deleteWall(id) {
    state.walls = state.walls.filter(w => w.id !== id);
    if (selectedId === id) selectItem(null);
    renderGeo(); renderOverlay(); scheduleSave();
  }
  function deleteSelection() {
    const kind = selKind(selectedId);
    if (kind === "person") deletePerson(selectedId);
    else if (kind === "zone") deleteZone(selectedId);
    else if (kind === "item") deleteItem(selectedId);
    else if (kind === "room") deleteRoom(selectedId, false);
    else if (kind === "wall") deleteWall(selectedId);
  }

  function viewCenterLocal() {
    const wrapRect = els.canvasWrap.getBoundingClientRect();
    return toLocal(wrapRect.left + wrapRect.width / 2, wrapRect.top + wrapRect.height / 2);
  }
  function addRectRoom(w, h) {
    const c = viewCenterLocal();
    const x0 = Math.round((c.x - w / 2) / SNAP_CM) * SNAP_CM;
    const y0 = Math.round((c.y - h / 2) / SNAP_CM) * SNAP_CM;
    const room = makeRoom(rectPoints(x0, y0, w, h));
    state.rooms.push(room);
    buildWallsForRoom(room, true);
    renderGeo();
    if (tool !== "select") setTool("select");
    selectItem(room.id);
    scheduleSave();
  }

  // ---------------------------------------------------------------
  // Seats — generation & layout, linked to a parent table/desk
  // ---------------------------------------------------------------
  function defaultSeatCount(table) {
    if (table.shape === "ellipse") return clamp(Math.round(Math.PI * table.w / 50), 4, 16);
    if (table.seatLayout === "single") return Math.max(1, Math.floor(table.w / 120));
    const perSide = clamp(Math.round(table.w / 50), 2, 8);
    return perSide * 2;
  }

  function computeSeatLocalPositions(table, count) {
    const positions = [];
    if (table.shape === "ellipse") {
      const r = table.w / 2 + SEAT_GAP + SEAT_SIZE / 2;
      for (let i = 0; i < count; i++) {
        const angle = (-90 + i * (360 / count)) * Math.PI / 180;
        positions.push({ x: r * Math.cos(angle), y: r * Math.sin(angle) });
      }
    } else if (table.seatLayout === "single") {
      const edgeOffset = table.h / 2 + SEAT_GAP + SEAT_SIZE / 2;
      const n = Math.max(1, count);
      for (let i = 0; i < n; i++) positions.push({ x: -table.w / 2 + (table.w / n) * (i + 0.5), y: edgeOffset });
    } else {
      const topCount = Math.ceil(count / 2);
      const bottomCount = count - topCount;
      const edgeOffset = table.h / 2 + SEAT_GAP + SEAT_SIZE / 2;
      for (let i = 0; i < topCount; i++) positions.push({ x: -table.w / 2 + (table.w / topCount) * (i + 0.5), y: -edgeOffset });
      for (let i = 0; i < bottomCount; i++) positions.push({ x: -table.w / 2 + (table.w / bottomCount) * (i + 0.5), y: edgeOffset });
    }
    return positions;
  }

  function worldFromLocal(table, local) {
    const theta = table.rot * Math.PI / 180;
    const cos = Math.cos(theta), sin = Math.sin(theta);
    return { x: table.x + (local.x * cos - local.y * sin), y: table.y + (local.x * sin + local.y * cos) };
  }

  function makeSeat(table, idx, pos) {
    const world = worldFromLocal(table, pos);
    const id = "item-" + (nextId++);
    const data = {
      id, type: "seat", name: String(idx + 1), shape: "ellipse",
      w: SEAT_SIZE, h: SEAT_SIZE, x: world.x, y: world.y, rot: 0,
      color: "#e7e4da", parentId: table.id, seatIndex: idx,
    };
    state.items.push(data);
    mountItem(data);
  }

  function createSeatsForTable(table, count) {
    computeSeatLocalPositions(table, count).forEach((pos, idx) => makeSeat(table, idx, pos));
  }

  function layoutChildSeats(table) {
    const children = getChildSeats(table.id);
    if (!children.length) return;
    const positions = computeSeatLocalPositions(table, children.length);
    children.forEach((c, i) => {
      const world = worldFromLocal(table, positions[i]);
      c.x = world.x; c.y = world.y;
      const el = itemEls.get(c.id);
      if (el) applyTransform(el, c);
    });
  }

  function syncSeatsForTable(table, newCount) {
    newCount = Math.max(1, Math.min(24, Math.round(newCount)));
    const children = getChildSeats(table.id);
    const positions = computeSeatLocalPositions(table, newCount);
    const keep = Math.min(children.length, newCount);
    for (let i = 0; i < keep; i++) {
      const c = children[i];
      const world = worldFromLocal(table, positions[i]);
      c.x = world.x; c.y = world.y; c.seatIndex = i;
      applyTransform(itemEls.get(c.id), c);
    }
    if (newCount > children.length) {
      for (let i = children.length; i < newCount; i++) makeSeat(table, i, positions[i]);
    } else if (newCount < children.length) {
      for (let i = newCount; i < children.length; i++) deleteItem(children[i].id);
    }
  }

  // ---------------------------------------------------------------
  // Items
  // ---------------------------------------------------------------
  function addItem(spec) {
    if (tool !== "select") setTool("select");
    const id = "item-" + (nextId++);
    const c = viewCenterLocal();
    const x = Math.round(c.x / SNAP_CM) * SNAP_CM;
    const y = Math.round(c.y / SNAP_CM) * SNAP_CM;

    const data = {
      id, type: spec.type, name: spec.name, shape: spec.shape, w: spec.w, h: spec.h,
      x, y, rot: 0, color: spec.color, parentId: null, seatIndex: null,
      seatLayout: spec.seatLayout || null,
    };
    state.items.push(data);
    mountItem(data);

    if (spec.seats) createSeatsForTable(data, defaultSeatCount(data));

    selectItem(id);
    scheduleSave();
  }

  function mountItem(data) {
    const el = createItemElement(data);
    const soft = TYPE_FLAGS[data.type] && TYPE_FLAGS[data.type].soft;
    if (soft) els.room.insertBefore(el, els.overlay.nextSibling); else els.room.appendChild(el);
    itemEls.set(data.id, el);
    if (data.type === "seat") updateSeatVisual(data);
    return el;
  }

  function createItemElement(data) {
    const el = document.createElement("div");
    el.className = "item" + (data.type === "seat" ? " seat" : "") + (TYPE_FLAGS[data.type] && TYPE_FLAGS[data.type].noCheck ? " util" : "");
    el.dataset.id = data.id;

    if (data.type !== "seat") {
      const inner = buildIconInner(data.type, data.w, data.h, data.color);
      if (inner) {
        const needsOverflow = data.type === "door";
        el.insertAdjacentHTML("beforeend",
          `<svg class="furniture-icon" width="100%" height="100%" viewBox="0 0 ${data.w} ${data.h}" preserveAspectRatio="none"${needsOverflow ? ' style="overflow:visible"' : ""}>${inner}</svg>`
        );
      } else {
        el.style.background = data.color;
        el.style.borderRadius = data.shape === "ellipse" ? "50%" : "3px";
      }
    }

    const label = document.createElement("div");
    label.className = "item-label";
    label.textContent = data.name;
    el.appendChild(label);

    if (data.shape === "ellipse") {
      const rh = document.createElement("div");
      rh.className = "handle handle-radius";
      rh.addEventListener("pointerdown", (e) => onRadiusDown(e, data.id));
      el.appendChild(rh);
      const rot = document.createElement("div");
      rot.className = "handle handle-rotate";
      rot.addEventListener("pointerdown", (e) => onRotateHandleDown(e, data.id));
      el.appendChild(rot);
    } else {
      const lenH = document.createElement("div");
      lenH.className = "handle handle-length";
      lenH.addEventListener("pointerdown", (e) => onLengthDown(e, data.id));
      el.appendChild(lenH);
      const depH = document.createElement("div");
      depH.className = "handle handle-depth";
      depH.addEventListener("pointerdown", (e) => onDepthDown(e, data.id));
      el.appendChild(depH);
      const rotC = document.createElement("div");
      rotC.className = "handle handle-rotate-corner";
      rotC.addEventListener("pointerdown", (e) => onRotateHandleDown(e, data.id));
      el.appendChild(rotC);
    }

    applyTransform(el, data);
    el.addEventListener("pointerdown", (e) => onItemPointerDown(e, data.id));
    el.addEventListener("dblclick", () => {
      selectItem(data.id);
      const nameInput = document.getElementById("propName");
      if (nameInput) { nameInput.focus(); nameInput.select(); }
    });
    return el;
  }

  function applyTransform(el, data) {
    const wpx = data.w * PX_PER_CM;
    const hpx = data.h * PX_PER_CM;
    el.style.width = wpx + "px";
    el.style.height = hpx + "px";
    requestCheck();
    el.style.transform = `translate(${(data.x * PX_PER_CM) - wpx / 2}px, ${(data.y * PX_PER_CM) - hpx / 2}px) rotate(${data.rot}deg)`;

    if (data.shape === "ellipse") {
      const rh = el.querySelector(".handle-radius");
      if (rh) { rh.style.left = (wpx - 7) + "px"; rh.style.top = (hpx / 2 - 7) + "px"; }
      const rot = el.querySelector(".handle-rotate");
      if (rot) { rot.style.left = (wpx / 2 - 7) + "px"; rot.style.top = "-22px"; }
    } else {
      const lenH = el.querySelector(".handle-length");
      if (lenH) { lenH.style.left = (wpx - 7) + "px"; lenH.style.top = (hpx / 2 - 7) + "px"; }
      const depH = el.querySelector(".handle-depth");
      if (depH) { depH.style.left = (wpx / 2 - 7) + "px"; depH.style.top = (hpx - 7) + "px"; }
      const rotC = el.querySelector(".handle-rotate-corner");
      if (rotC) { rotC.style.left = (wpx + 4) + "px"; rotC.style.top = "-18px"; }
    }
  }

  // Utilities (pipes, cables) are faint, and solid while the tool is active or a pipe is selected
  function updatePipesOn() {
    const w = selectedId && selKind(selectedId) === "wall" ? getWall(selectedId) : null;
    els.canvasWrap.classList.toggle("pipes-on", tool === "pipe" || !!(w && PIPE_KINDS[w.kind]));
  }
  function selectItem(id) {
    multi.clear();
    selectedId = id;
    refreshSelection();
    updatePipesOn();
    updateChildHighlights();
    renderProps();
    renderOverlay();
  }
  function refreshSelection() {
    const many = multi.size > 1;
    itemEls.forEach((el, id) => el.classList.toggle("selected", many ? multi.has(id) : id === selectedId));
    els.canvasWrap.classList.toggle("multi", many);
  }
  function currentSelectionIds() {
    if (multi.size > 1) return Array.from(multi);
    return selectedId && selKind(selectedId) === "item" && getItem(selectedId) ? [selectedId] : [];
  }
  function setSelection(ids, light) {
    const list = ids.filter(id => getItem(id));
    multi = new Set(list.length > 1 ? list : []);
    selectedId = list.length ? list[list.length - 1] : null;
    refreshSelection();
    if (!light) { updateChildHighlights(); renderProps(); renderOverlay(); }
  }
  function toggleInSelection(id) {
    const cur = currentSelectionIds();
    const i = cur.indexOf(id);
    if (i >= 0) cur.splice(i, 1); else cur.push(id);
    setSelection(cur, false);
  }
  function selectedRoots() {
    const ids = multi.size > 1 ? multi : new Set(selectedId ? [selectedId] : []);
    return state.items.filter(it => ids.has(it.id) && !(it.parentId && ids.has(it.parentId)));
  }
  function rotateGroup(step) {
    const roots = selectedRoots();
    if (!roots.length) return;
    const cx = roots.reduce((s, it) => s + it.x, 0) / roots.length, cy = roots.reduce((s, it) => s + it.y, 0) / roots.length;
    const th = step * Math.PI / 180, c = Math.cos(th), sn = Math.sin(th);
    roots.forEach(it => {
      const dx = it.x - cx, dy = it.y - cy;
      it.x = r1(cx + dx * c - dy * sn); it.y = r1(cy + dx * sn + dy * c);
      it.rot = (it.rot + step) % 360;
      applyTransform(itemEls.get(it.id), it);
      layoutChildSeats(it);
    });
    scheduleSave();
  }
  function deleteMulti() {
    const ids = Array.from(multi);
    selectItem(null);
    ids.forEach(id => { if (getItem(id)) deleteItem(id); });
  }
  function startMarquee(e) {
    const wrapRect = els.canvasWrap.getBoundingClientRect();
    const sx = e.clientX, sy = e.clientY;
    const additive = e.shiftKey || e.ctrlKey || e.metaKey;
    const base = additive ? currentSelectionIds() : [];
    let moved = false;
    trackPointer((ev) => {
      if (!moved && Math.hypot(ev.clientX - sx, ev.clientY - sy) < 4) return;
      moved = true;
      const x0 = Math.min(sx, ev.clientX), y0 = Math.min(sy, ev.clientY), x1 = Math.max(sx, ev.clientX), y1 = Math.max(sy, ev.clientY);
      const m = els.marquee;
      m.style.display = "block";
      m.style.left = (x0 - wrapRect.left) + "px"; m.style.top = (y0 - wrapRect.top) + "px";
      m.style.width = (x1 - x0) + "px"; m.style.height = (y1 - y0) + "px";
      const a = toLocal(x0, y0), b = toLocal(x1, y1);
      const box = { x0: a.x, y0: a.y, x1: b.x, y1: b.y };
      const ids = base.slice();
      state.items.forEach(it => { if (ids.indexOf(it.id) < 0 && bboxHit(bboxOf(itemPoly(it)), box)) ids.push(it.id); });
      setSelection(ids, true);
    }, () => {
      els.marquee.style.display = "none";
      if (!moved) { if (!additive) selectItem(null); return; }
      setSelection(currentSelectionIds(), false);
    });
  }

  function updateChildHighlights() {
    itemEls.forEach(el => el.classList.remove("child-active"));
    if (!selectedId || multi.size > 1) return;
    if (selKind(selectedId) === "person") { const ps = seatOf(selectedId); const pe = ps && itemEls.get(ps.id); if (pe) pe.classList.add("child-active"); return; }
    getChildSeats(selectedId).forEach(c => { const el = itemEls.get(c.id); if (el) el.classList.add("child-active"); });
  }

  function deleteItem(id) {
    getChildSeats(id).forEach(c => deleteItem(c.id));
    const el = itemEls.get(id);
    if (el) el.remove();
    itemEls.delete(id);
    state.items = state.items.filter(it => it.id !== id);
    requestCheck();
    if (selectedId === id) selectItem(null);
    scheduleSave();
  }

  // ---------------------------------------------------------------
  // Drag helper (window-level, survives re-rendering of handles)
  // ---------------------------------------------------------------
  function trackPointer(onMove, onUp) {
    const mv = (e) => onMove(e);
    const up = (e) => {
      window.removeEventListener("pointermove", mv);
      window.removeEventListener("pointerup", up);
      window.removeEventListener("pointercancel", up);
      if (onUp) onUp(e);
    };
    window.addEventListener("pointermove", mv);
    window.addEventListener("pointerup", up);
    window.addEventListener("pointercancel", up);
  }

  // ---------------------------------------------------------------
  // Item drag (children follow via layoutChildSeats)
  // ---------------------------------------------------------------
  let dragCtx = null;
  function onItemPointerDown(e, id) {
    if (e.target.classList.contains("handle")) return;
    if (viewOnly || e.button !== 0 || spaceDown) return;
    e.preventDefault();
    if (e.shiftKey || e.ctrlKey || e.metaKey) { toggleInSelection(id); return; }
    const inGroup = multi.size > 1 && multi.has(id);
    if (!inGroup) selectItem(id);
    const data = getItem(id);
    const el = itemEls.get(id);
    el.setPointerCapture(e.pointerId);
    el.style.cursor = "grabbing";
    dragCtx = { id, pointerId: e.pointerId, startClientX: e.clientX, startClientY: e.clientY, startX: data.x, startY: data.y, group: inGroup ? selectedRoots().map(it => ({ it, x0: it.x, y0: it.y })) : null };
    el.addEventListener("pointermove", onItemPointerMove);
    el.addEventListener("pointerup", onItemPointerUp);
    el.addEventListener("pointercancel", onItemPointerUp);
  }
  function onItemPointerMove(e) {
    if (!dragCtx || e.pointerId !== dragCtx.pointerId) return;
    const data = getItem(dragCtx.id);
    const el = itemEls.get(dragCtx.id);
    if (!data || !el) return;
    const dxPx = (e.clientX - dragCtx.startClientX) / zoom;
    const dyPx = (e.clientY - dragCtx.startClientY) / zoom;
    if (dragCtx.group) {
      const gx = Math.round((dxPx / PX_PER_CM) / SNAP_CM) * SNAP_CM, gy = Math.round((dyPx / PX_PER_CM) / SNAP_CM) * SNAP_CM;
      dragCtx.group.forEach(g => { g.it.x = g.x0 + gx; g.it.y = g.y0 + gy; applyTransform(itemEls.get(g.it.id), g.it); layoutChildSeats(g.it); });
      return;
    }
    const st = (TYPE_FLAGS[data.type] && TYPE_FLAGS[data.type].noCheck) ? 2.5 : SNAP_CM;
    data.x = Math.round((dragCtx.startX + dxPx / PX_PER_CM) / st) * st;
    data.y = Math.round((dragCtx.startY + dyPx / PX_PER_CM) / st) * st;
    applyTransform(el, data);
    layoutChildSeats(data);
  }
  function onItemPointerUp() {
    if (!dragCtx) return;
    const el = itemEls.get(dragCtx.id);
    if (el) {
      el.style.cursor = "grab";
      el.removeEventListener("pointermove", onItemPointerMove);
      el.removeEventListener("pointerup", onItemPointerUp);
      el.removeEventListener("pointercancel", onItemPointerUp);
    }
    dragCtx = null;
    renderProps();
    scheduleSave();
  }

  // ---------------------------------------------------------------
  // Rotate — relative to where the handle was grabbed, so no jump
  // ---------------------------------------------------------------
  let rotateCtx = null;
  function onRotateHandleDown(e, id) {
    if (e.button !== 0 || spaceDown) return;
    e.preventDefault(); e.stopPropagation();
    selectItem(id);
    const data = getItem(id);
    const el = itemEls.get(id);
    const rect = el.getBoundingClientRect();
    const cx = rect.left + rect.width / 2, cy = rect.top + rect.height / 2;
    const handle = e.currentTarget;
    handle.setPointerCapture(e.pointerId);
    rotateCtx = {
      id, pointerId: e.pointerId, handleEl: handle, cx, cy,
      startAngle: Math.atan2(e.clientY - cy, e.clientX - cx) * 180 / Math.PI,
      startRot: data.rot,
    };
    handle.addEventListener("pointermove", onRotateMove);
    handle.addEventListener("pointerup", onRotateUp);
    handle.addEventListener("pointercancel", onRotateUp);
  }
  function onRotateMove(e) {
    if (!rotateCtx || e.pointerId !== rotateCtx.pointerId) return;
    const data = getItem(rotateCtx.id);
    const el = itemEls.get(rotateCtx.id);
    if (!data || !el) return;
    const cur = Math.atan2(e.clientY - rotateCtx.cy, e.clientX - rotateCtx.cx) * 180 / Math.PI;
    let rot = rotateCtx.startRot + (cur - rotateCtx.startAngle);
    rot = ((rot % 360) + 360) % 360;
    if (!e.shiftKey) {                       // magnetic snap to every 15°, free in between
      const n = Math.round(rot / 15) * 15;
      if (Math.abs(rot - n) < 5) rot = n;
    }
    data.rot = Math.round((rot % 360) * 10) / 10;
    applyTransform(el, data);
    layoutChildSeats(data);
  }
  function onRotateUp() {
    if (!rotateCtx) return;
    const handle = rotateCtx.handleEl;
    handle.removeEventListener("pointermove", onRotateMove);
    handle.removeEventListener("pointerup", onRotateUp);
    handle.removeEventListener("pointercancel", onRotateUp);
    rotateCtx = null;
    renderProps();
    scheduleSave();
  }

  // ---------------------------------------------------------------
  // Resize — single-axis handles, rotation-aware, symmetric around center
  // ---------------------------------------------------------------
  let axisCtx = null;
  function onLengthDown(e, id) { startAxisResize(e, id, "length"); }
  function onDepthDown(e, id) { startAxisResize(e, id, "depth"); }
  function onRadiusDown(e, id) { startAxisResize(e, id, "radius"); }

  function startAxisResize(e, id, axis) {
    if (e.button !== 0 || spaceDown) return;
    e.preventDefault(); e.stopPropagation();
    selectItem(id);
    const data = getItem(id);
    const handle = e.currentTarget;
    handle.setPointerCapture(e.pointerId);
    axisCtx = {
      id, pointerId: e.pointerId, axis, handleEl: handle,
      startClientX: e.clientX, startClientY: e.clientY,
      startW: data.w, startH: data.h, theta: data.rot * Math.PI / 180,
    };
    handle.addEventListener("pointermove", onAxisMove);
    handle.addEventListener("pointerup", onAxisUp);
    handle.addEventListener("pointercancel", onAxisUp);
  }
  function onAxisMove(e) {
    if (!axisCtx || e.pointerId !== axisCtx.pointerId) return;
    const data = getItem(axisCtx.id);
    const el = itemEls.get(axisCtx.id);
    if (!data || !el) return;
    const dxCm = ((e.clientX - axisCtx.startClientX) / zoom) / PX_PER_CM;
    const dyCm = ((e.clientY - axisCtx.startClientY) / zoom) / PX_PER_CM;
    const cos = Math.cos(axisCtx.theta), sin = Math.sin(axisCtx.theta);
    const lx = dxCm * cos + dyCm * sin;
    const ly = -dxCm * sin + dyCm * cos;

    const fl = TYPE_FLAGS[data.type] || {};
    const stp = fl.noCheck ? 1 : 5, mn = fl.noCheck ? 3 : 10;
    if (axisCtx.axis === "length") {
      data.w = Math.max(mn, Math.round((axisCtx.startW + lx * 2) / stp) * stp);
    } else if (axisCtx.axis === "depth") {
      data.h = Math.max(mn, Math.round((axisCtx.startH + ly * 2) / stp) * stp);
    } else {
      const d = Math.max(mn, Math.round((axisCtx.startW + lx * 2) / stp) * stp);
      data.w = d; data.h = d;
    }
    applyTransform(el, data);
    layoutChildSeats(data);
  }
  function onAxisUp() {
    if (!axisCtx) return;
    const handle = axisCtx.handleEl;
    handle.removeEventListener("pointermove", onAxisMove);
    handle.removeEventListener("pointerup", onAxisUp);
    handle.removeEventListener("pointercancel", onAxisUp);
    const data = getItem(axisCtx.id);
    if (data) refreshIcon(data);
    axisCtx = null;
    renderProps();
    scheduleSave();
  }

  function refreshIcon(data) {
    if (data.type === "seat") return;
    const el = itemEls.get(data.id);
    const svg = el && el.querySelector(".furniture-icon");
    const inner = buildIconInner(data.type, data.w, data.h, data.color);
    if (svg && inner) { svg.setAttribute("viewBox", `0 0 ${data.w} ${data.h}`); svg.innerHTML = inner; }
  }

  // ---------------------------------------------------------------
  // Tools: select / room / wall / partition
  // ---------------------------------------------------------------
  const HINTS = {
    room: "Клик — поставить вершину. Клик по первой точке или Enter — замкнуть комнату. Правая кнопка (клик) — готово. Shift — угол 45°.",
    zone: "Нажмите в центре и тяните до нужного радиуса. Простой клик — зона радиусом 1,5 м.",
    pipe: "Выберите тип коммуникации выше. Клик — точка, следующие клики продолжают линию. Двойной клик, правый клик или Enter — закончить. Shift — угол 45°.",
    wall: "Клик — точка стены, следующие клики продолжают цепочку. Двойной клик, правый клик или Enter — закончить. Shift — угол 45°.",
    partition: "Клик — точка перегородки, следующие клики продолжают цепочку. Двойной клик, правый клик или Enter — закончить. Shift — угол 45°.",
  };

  function setTool(t) {
    tool = t;
    draw = { pts: [], first: null, count: 0, cursor: null };
    els.canvasWrap.classList.toggle("drawing", t !== "select");
    updatePipesOn();
    els.tools.querySelectorAll("button").forEach(b => b.classList.toggle("active", b.dataset.tool === t));
    els.drawBar.classList.toggle("show", t !== "select");
    els.drawHint.textContent = HINTS[t] || "";
    document.getElementById("drawTWrap").style.display = (t === "wall" || t === "partition" || t === "pipe") ? "" : "none";
    document.getElementById("drawKindWrap").style.display = t === "pipe" ? "" : "none";
    document.getElementById("drawT").value = defaultT(t === "wall" ? "wall" : t === "partition" ? "partition" : pipeKind);
    if (t !== "select") selectItem(null); else renderOverlay();
  }
  els.tools.addEventListener("click", (e) => {
    const b = e.target.closest("button[data-tool]");
    if (b) setTool(b.dataset.tool);
  });
  document.getElementById("drawDone").addEventListener("click", () => { finishDrawing(true); if (tool !== "room") setTool("select"); });
  document.getElementById("drawCancel").addEventListener("click", () => setTool("select"));
  document.getElementById("drawT").addEventListener("change", (e) => {
    const v = clamp(parseFloat(e.target.value) || 0, 1, 100);
    const k = drawKind();
    if (!v) { e.target.value = defaultT(k); return; }
    if (PIPE_KINDS[k]) pipeTs[k] = v; else if (k === "partition") partT = v; else wallT = v;
    e.target.value = v;
    scheduleSave(); renderOverlay();
  });
  (function fillKinds() {
    const sel = document.getElementById("drawKind");
    sel.innerHTML = Object.keys(PIPE_KINDS).map(k => `<option value="${k}">${PIPE_KINDS[k].name}</option>`).join("");
    sel.addEventListener("change", (e) => { pipeKind = e.target.value; document.getElementById("drawT").value = defaultT(pipeKind); renderOverlay(); });
  })();

  function snapDraw(e) {
    let p = toLocal(e.clientX, e.clientY);
    const last = draw.pts[draw.pts.length - 1];
    if (e.shiftKey && last) {
      const dx = p.x - last.x, dy = p.y - last.y;
      const step = Math.PI / 4;
      const ang = Math.round(Math.atan2(dy, dx) / step) * step;
      const L = Math.round(Math.hypot(dx, dy) / SNAP_CM) * SNAP_CM;
      return { x: r1(last.x + Math.cos(ang) * L), y: r1(last.y + Math.sin(ang) * L), snapped: false };
    }
    return snapPoint(p, null);
  }

  function finishDrawing(commit) {
    if (tool === "room") {
      if (commit && draw.pts.length >= 3) {
        const room = makeRoom(draw.pts);
        state.rooms.push(room);
        renderGeo(); scheduleSave();
        setTool("select");
        selectItem(room.id);
        showToast("Комната создана — можно построить стены по контуру");
        return;
      }
    }
    draw.pts = []; draw.first = null; draw.count = 0;
    renderOverlay();
  }

  els.canvasWrap.addEventListener("pointermove", (e) => {
    if (tool === "select") return;
    draw.cursor = snapDraw(e);
    renderOverlay();
  });

  els.canvasWrap.addEventListener("pointerdown", (e) => {
    if (viewOnly) {
      e.preventDefault();
      startPan(e, false, e.pointerType === "touch" ? () => { const h = tipHtmlFor(e.target); if (h) showTip(h, e.clientX, e.clientY); else hideTip(); } : null);
      return;
    }
    if (e.button === 2 || e.button === 1 || (spaceDown && e.button === 0)) {
      e.preventDefault();
      const hv = e.button === 2 && tool === "select" && e.target.closest ? e.target.closest("[data-h='rv']") : null;
      const vi = hv ? parseInt(hv.dataset.i, 10) : -1;
      startPan(e, false, e.button === 2 ? () => { if (tool !== "select") finishDrawing(true); else if (vi >= 0) removeVertex(vi); } : null);
      return;
    }
    if (tool === "select") {
      if (e.button === 0 && e.target === els.canvasWrap) {
        e.preventDefault();
        if (e.pointerType === "touch") startPan(e, true); else startMarquee(e);
      }
      return;
    }
    if (e.button !== 0) return;
    e.preventDefault();
    if (tool === "zone") { startZoneDraw(e); return; }
    const p = snapDraw(e);
    draw.cursor = p;
    if (tool === "room") {
      if (draw.pts.length >= 3 && Math.hypot(p.x - draw.pts[0].x, p.y - draw.pts[0].y) < 1) { finishDrawing(true); return; }
      const last = draw.pts[draw.pts.length - 1];
      if (last && Math.hypot(p.x - last.x, p.y - last.y) < 1) return;
      draw.pts.push({ x: p.x, y: p.y });
    } else {
      const kind = drawKind();
      if (!draw.pts.length) {
        draw.pts = [{ x: p.x, y: p.y }];
        draw.first = { x: p.x, y: p.y };
        draw.count = 0;
      } else {
        const last = draw.pts[0];
        if (Math.hypot(p.x - last.x, p.y - last.y) < 1) return;
        addWall(last, p, kind);
        draw.count++;
        renderGeo(); scheduleSave();
        if (draw.count >= 2 && Math.hypot(p.x - draw.first.x, p.y - draw.first.y) < 1) { finishDrawing(false); return; }
        draw.pts = [{ x: p.x, y: p.y }];
      }
    }
    renderOverlay();
  });
  els.canvasWrap.addEventListener("dblclick", () => { if (tool !== "select") finishDrawing(true); });
  els.canvasWrap.addEventListener("contextmenu", (e) => e.preventDefault());

  // ---------------------------------------------------------------
  // Selecting / moving rooms and walls (select tool)
  // ---------------------------------------------------------------
  function onGeoDown(e) {
    if (viewOnly || tool !== "select") return;
    if (e.button !== 0 || spaceDown) return;
    const t = e.target.closest("[data-kind]");
    if (!t) return;
    e.preventDefault();
    const id = t.dataset.id;
    selectItem(id);
    const kind = t.dataset.kind;
    if (kind === "room") startRoomMove(e, getRoom(id));
    else if (kind === "zone") startZoneMove(e, getZone(id));
    else startWallMove(e, getWall(id));
  }
  els.geo.addEventListener("pointerdown", onGeoDown);
  els.labelsLayer.addEventListener("pointerdown", onGeoDown);

  function startRoomMove(e, room) {
    if (!room) return;
    const s0 = toLocal(e.clientX, e.clientY);
    const refs = mergeRefs(room.points.map(p => collectGroup(p.x, p.y, false)));
    const pts = room.points.map(p => ({ o: p, kx: "x", ky: "y", x0: p.x, y0: p.y }));
    const idset = new Set(state.items.filter(it => pointInPoly(it.x, it.y, room.points)).map(it => it.id));
    state.items.forEach(it => { if (it.parentId && idset.has(it.parentId)) idset.add(it.id); });
    const movers = state.items.filter(it => idset.has(it.id)).map(it => ({ it, x0: it.x, y0: it.y }));
    const sx = e.clientX, sy = e.clientY;
    let moved = false;
    trackPointer((ev) => {
      if (!moved && Math.hypot(ev.clientX - sx, ev.clientY - sy) < 4) return;
      moved = true;
      if (!dragDims) { dragDims = true; showDimHint(true); }
      const p = toLocal(ev.clientX, ev.clientY);
      const dx = Math.round((p.x - s0.x) / SNAP_CM) * SNAP_CM;
      const dy = Math.round((p.y - s0.y) / SNAP_CM) * SNAP_CM;
      refs.concat(pts).forEach(r => { r.o[r.kx] = r1(r.x0 + dx); r.o[r.ky] = r1(r.y0 + dy); });
      movers.forEach(m => { m.it.x = m.x0 + dx; m.it.y = m.y0 + dy; applyTransform(itemEls.get(m.it.id), m.it); });
      renderGeo(); renderOverlay();
    }, () => { dragDims = false; showDimHint(false); if (moved) scheduleSave(); renderProps(); renderOverlay(); });
  }

  function startWallMove(e, w) {
    if (!w) return;
    const s0 = toLocal(e.clientX, e.clientY);
    const refs = mergeRefs([collectGroup(w.x1, w.y1, true), collectGroup(w.x2, w.y2, true)]);
    const sx = e.clientX, sy = e.clientY;
    let moved = false;
    trackPointer((ev) => {
      if (!moved && Math.hypot(ev.clientX - sx, ev.clientY - sy) < 4) return;
      moved = true;
      if (!dragDims) { dragDims = true; showDimHint(true); }
      const p = toLocal(ev.clientX, ev.clientY);
      const dx = Math.round((p.x - s0.x) / SNAP_CM) * SNAP_CM;
      const dy = Math.round((p.y - s0.y) / SNAP_CM) * SNAP_CM;
      refs.forEach(r => { r.o[r.kx] = r1(r.x0 + dx); r.o[r.ky] = r1(r.y0 + dy); });
      renderGeo(); renderOverlay();
    }, () => { dragDims = false; showDimHint(false); if (moved) scheduleSave(); renderProps(); renderOverlay(); });
  }

  // ---------------------------------------------------------------
  // Handles on the overlay: room vertices / midpoints, wall ends
  // ---------------------------------------------------------------
  function startPointDrag(refs) {
    const ex = new Set(refs.map(r => r.key));
    dragDims = true; showDimHint(true); renderOverlay();
    trackPointer((ev) => {
      const p = snapPoint(toLocal(ev.clientX, ev.clientY), ex);
      refs.forEach(r => { r.o[r.kx] = r1(p.x); r.o[r.ky] = r1(p.y); });
      renderGeo(); renderOverlay();
    }, () => { dragDims = false; showDimHint(false); scheduleSave(); renderProps(); renderOverlay(); });
  }

  els.overlay.addEventListener("pointerdown", (e) => {
    if (tool !== "select") return;
    if (e.button !== 0 || spaceDown) return;
    const h = e.target.closest("[data-h]");
    if (!h) return;
    e.preventDefault(); e.stopPropagation();
    const type = h.dataset.h, i = parseInt(h.dataset.i, 10);

    if (type === "rv") {
      const r = getRoom(selectedId); if (!r) return;
      startPointDrag(collectGroup(r.points[i].x, r.points[i].y, true));
    } else if (type === "we") {
      const w = getWall(selectedId); if (!w) return;
      const x = i === 1 ? w.x1 : w.x2, y = i === 1 ? w.y1 : w.y2;
      startPointDrag(collectGroup(x, y, true));
    } else if (type === "zr") {
      startZoneRadius();
    } else if (type === "rm") {
      const r = getRoom(selectedId); if (!r) return;
      const n = r.points.length;
      const a = r.points[i], b = r.points[(i + 1) % n];
      const mid = { x: r1((a.x + b.x) / 2), y: r1((a.y + b.y) / 2) };
      const ax = a.x, ay = a.y, bx = b.x, by = b.y;
      const wall = state.walls.find(w =>
        (near(w.x1, w.y1, ax, ay) && near(w.x2, w.y2, bx, by)) ||
        (near(w.x1, w.y1, bx, by) && near(w.x2, w.y2, ax, ay)));
      r.points.splice(i + 1, 0, mid);
      const refs = [{ o: mid, kx: "x", ky: "y", key: r.id + ":new" }];
      if (wall) {                             // split the wall under this edge at the new vertex
        const w2 = Object.assign({}, wall, { id: "wall-" + (nextId++) });
        w2.x1 = mid.x; w2.y1 = mid.y;
        wall.x2 = mid.x; wall.y2 = mid.y;
        state.walls.push(w2);
        refs.push({ o: wall, kx: "x2", ky: "y2", key: wall.id + ":2" });
        refs.push({ o: w2, kx: "x1", ky: "y1", key: w2.id + ":1" });
      }
      startPointDrag(refs);
    }
  });

  function removeVertex(i) {
    const r = getRoom(selectedId);
    if (!r || i < 0 || i >= r.points.length) return;
    if (r.points.length <= 3) { showToast("В комнате должно быть минимум 3 вершины"); return; }
    r.points.splice(i, 1);
    renderGeo(); renderOverlay(); renderProps(); scheduleSave();
  }
  els.overlay.addEventListener("dblclick", (e) => {
    if (tool !== "select") return;
    const h = e.target.closest("[data-h='rv']");
    if (h) { e.preventDefault(); removeVertex(parseInt(h.dataset.i, 10)); }
  });

  // ---------------------------------------------------------------
  // Circular zones
  // ---------------------------------------------------------------
  const ZONE_COLORS = ["#2f5fa8", "#3f9a62", "#d9822b", "#8a55c9", "#c4485a", "#6b7280"];
  function zonePoly(z) {
    const pts = [];
    for (let i = 0; i < 36; i++) { const a = (i / 36) * Math.PI * 2; pts.push({ x: z.cx + Math.cos(a) * z.r, y: z.cy + Math.sin(a) * z.r }); }
    return pts;
  }
  function addZone(cx, cy, r) {
    const z = { id: "zone-" + (nextId++), name: "Зона " + (state.zones.length + 1), cx: r1(cx), cy: r1(cy), r, color: ZONE_COLORS[state.zones.length % ZONE_COLORS.length], wallT: 0 };
    state.zones.push(z);
    return z;
  }
  function addZoneAtCenter(r) {
    const c = viewCenterLocal();
    const z = addZone(Math.round(c.x / SNAP_CM) * SNAP_CM, Math.round(c.y / SNAP_CM) * SNAP_CM, r);
    renderGeo();
    if (tool !== "select") setTool("select");
    selectItem(z.id);
    scheduleSave();
  }
  function deleteZone(id) {
    state.zones = state.zones.filter(z => z.id !== id);
    if (selectedId === id) selectItem(null);
    renderGeo(); renderOverlay(); scheduleSave();
  }
  function startZoneDraw(e) {
    const c = snapDraw(e);
    draw.zone = { cx: c.x, cy: c.y, r: 0 };
    renderOverlay();
    trackPointer((ev) => {
      const p = toLocal(ev.clientX, ev.clientY);
      draw.zone.r = Math.round(Math.hypot(p.x - c.x, p.y - c.y) / 10) * 10;
      renderOverlay();
    }, () => {
      const r = draw.zone && draw.zone.r >= 20 ? draw.zone.r : 150;
      const z = addZone(c.x, c.y, r);
      draw.zone = null;
      renderGeo();
      setTool("select");
      selectItem(z.id);
      scheduleSave();
    });
  }
  function startZoneMove(e, z) {
    if (!z) return;
    const s0 = toLocal(e.clientX, e.clientY);
    const idset = new Set(state.items.filter(it => Math.hypot(it.x - z.cx, it.y - z.cy) <= z.r).map(it => it.id));
    state.items.forEach(it => { if (it.parentId && idset.has(it.parentId)) idset.add(it.id); });
    const movers = state.items.filter(it => idset.has(it.id)).map(it => ({ it, x0: it.x, y0: it.y }));
    const cx0 = z.cx, cy0 = z.cy, sx = e.clientX, sy = e.clientY;
    let moved = false;
    trackPointer((ev) => {
      if (!moved && Math.hypot(ev.clientX - sx, ev.clientY - sy) < 4) return;
      moved = true;
      const p = toLocal(ev.clientX, ev.clientY);
      const dx = Math.round((p.x - s0.x) / SNAP_CM) * SNAP_CM, dy = Math.round((p.y - s0.y) / SNAP_CM) * SNAP_CM;
      z.cx = r1(cx0 + dx); z.cy = r1(cy0 + dy);
      movers.forEach(m => { m.it.x = m.x0 + dx; m.it.y = m.y0 + dy; applyTransform(itemEls.get(m.it.id), m.it); });
      renderGeo(); renderOverlay();
    }, () => { if (moved) scheduleSave(); renderProps(); });
  }
  function startZoneRadius() {
    const z = getZone(selectedId);
    if (!z) return;
    trackPointer((ev) => {
      const p = toLocal(ev.clientX, ev.clientY);
      z.r = Math.max(20, Math.round(Math.hypot(p.x - z.cx, p.y - z.cy) / 10) * 10);
      renderGeo(); renderOverlay();
    }, () => { scheduleSave(); renderProps(); });
  }
  function renderZoneProps(z) {
    const body = els.propsBody;
    if (!z) { body.innerHTML = ""; return; }
    body.innerHTML = `
      <div class="props-name"><input type="text" id="zName" value="${escapeAttr(z.name)}"></div>
      <div class="swatches">${ZONE_COLORS.map(c => `<button class="swatch${c === z.color ? " on" : ""}" data-c="${c}" style="background:${c}" aria-label="Цвет"></button>`).join("")}</div>
      <div class="prop-row"><label>Радиус, см</label><input type="number" id="zR" min="20" max="3000" step="10" value="${Math.round(z.r)}"></div>
      <div class="stat"><span>Диаметр</span><b>${(z.r * 2 / 100).toFixed(2)} м</b></div>
      <div class="stat"><span>Площадь</span><b>${(Math.PI * z.r * z.r / 10000).toFixed(2)} м²</b></div>
      <div class="prop-row"><label>Стена по кругу, см</label><input type="number" id="zWall" min="0" max="100" step="2" value="${z.wallT || 0}"></div>
      <button class="full-btn danger" id="zDel">Удалить зону</button>
    `;
    document.getElementById("zName").addEventListener("input", (e) => { z.name = e.target.value; renderRoomLabels(); scheduleSave(); });
