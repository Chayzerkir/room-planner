      case "shelf":
        return `<rect x="0" y="0" width="${w}" height="${h}" rx="2" fill="${lt}" stroke="${dk}" stroke-width="1.4"/>
                <line x1="2" y1="${h*0.33}" x2="${w-2}" y2="${h*0.33}" stroke="${dk}" stroke-width="1" opacity="0.7"/>
                <line x1="2" y1="${h*0.66}" x2="${w-2}" y2="${h*0.66}" stroke="${dk}" stroke-width="1" opacity="0.7"/>`;
      case "bed":
        return `<rect x="0" y="0" width="${w}" height="${h}" rx="6" fill="${color}" stroke="${dk}" stroke-width="1.4"/>
