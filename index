  function drawKind() { return tool === "wall" ? "wall" : tool === "partition" ? "partition" : pipeKind; }
  function near(ax, ay, bx, by) { return Math.abs(ax - bx) < EPS && Math.abs(ay - by) < EPS; }

  function computeNextId() {
    let m = 0;
    [state.items, state.rooms || [], state.walls || [], state.zones || [], state.people || []].forEach(list => list.forEach(o => {
      const n = parseInt(String(o.id).split("-").pop(), 10);
