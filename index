  function renderNotes() {
    const k = 1 / (PX_PER_CM * zoom);
    const badge = (x, y, id) => `<g data-note="${id}" transform="translate(${r1(x)},${r1(y)}) scale(${k})" style="pointer-events:all;cursor:pointer;touch-action:none"><circle r="9" fill="var(--accent)" stroke="var(--accent-contrast)" stroke-width="1.5"/><path d="M-4.5 -3.5h9v5.5h-4l-2 2.2v-2.2h-3z" fill="var(--accent-contrast)"/></g>`;
    let s = "";
    state.items.forEach(it => {
      if (!it.comment) return;
      const bb = bboxOf(itemPoly(it));
      s += badge(bb.x1, bb.y0, it.id);
    });
    state.people.forEach(p => {
      if (!p.comment) return;
      const seat = seatOf(p.id);
      if (!seat) return;
      const bb = bboxOf(itemPoly(seat));
      s += badge(bb.x0, bb.y0, p.id);
    });
    state.rooms.forEach(r => {
      if (!r.comment || !r.points.length) return;
      const v = r.points.reduce((a, b) => (a.x + a.y <= b.x + b.y ? a : b));
      s += badge(v.x + 18 * k + 12, v.y + 18 * k + 12, r.id);
    });
    state.walls.forEach(w => { if (w.comment) s += badge((w.x1 + w.x2) / 2, (w.y1 + w.y2) / 2, w.id); });
    state.zones.forEach(z => { if (z.comment) s += badge(z.cx, z.cy - z.r, z.id); });
    els.notesLayer.innerHTML = s;
  }
