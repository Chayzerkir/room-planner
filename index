<!doctype html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Чертёжник — планировщик помещений</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-app: #f2efe6; --bg-panel: #ffffff; --bg-canvas: #fbfaf6;
    --ink: #20242b; --ink-muted: #6b7280;
    --accent: #2f5fa8; --accent-contrast: #ffffff;
    --border: #ded8c7; --grid-minor: #e6e1d2; --grid-major: #cec7b1;
    --danger: #b34a3c;
    --wall: #343a42; --partition: #858b95;
    --floor: rgba(47,95,168,0.06); --room-line: #9a9585;
    --grid-fine: #efeadf; --bad: #e5372b;
    --grid-minor-size: 28px; --grid-major-size: 140px;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg-app: #0a2240; --bg-panel: #0e2c52; --bg-canvas: #0c2949;
      --ink: #e9f1ff; --ink-muted: #96b1da; --accent: #7fb4ff; --accent-contrast: #072042;
      --border: #28497a; --grid-minor: rgba(255,255,255,0.07); --grid-major: rgba(255,255,255,0.16);
      --danger: #ff9b8a; --wall: #e3eeff; --partition: #86a9e3;
      --floor: rgba(127,180,255,0.10); --room-line: #5f82b8;
      --grid-fine: rgba(255,255,255,0.035); --bad: #ff6b5c;
    }
  }
  :root[data-theme="dark"] {
    --bg-app: #0a2240; --bg-panel: #0e2c52; --bg-canvas: #0c2949;
    --ink: #e9f1ff; --ink-muted: #96b1da; --accent: #7fb4ff; --accent-contrast: #072042;
    --border: #28497a; --grid-minor: rgba(255,255,255,0.07); --grid-major: rgba(255,255,255,0.16);
    --danger: #ff9b8a; --wall: #e3eeff; --partition: #86a9e3;
    --floor: rgba(127,180,255,0.10); --room-line: #5f82b8;
      --grid-fine: rgba(255,255,255,0.035); --bad: #ff6b5c;
  }

  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body {
    background: var(--bg-app); color: var(--ink); font-family: "Inter", system-ui, sans-serif;
    font-size: 14px; overflow: hidden;
    padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .brand, .section-label, button { font-family: "Space Grotesk", "Inter", system-ui, sans-serif; }

  .app { display: grid; grid-template-rows: auto 1fr; height: 100%; }

  header {
    display: flex; align-items: center; gap: 20px;
    padding: 10px 16px; padding-top: calc(10px + env(safe-area-inset-top, 0px));
    background: var(--bg-panel); border-bottom: 1px solid var(--border); flex-wrap: wrap;
  }
  .brand { font-weight: 700; font-size: 18px; letter-spacing: -0.01em; white-space: nowrap; }
  .brand small { display: block; font-family: "Inter", sans-serif; font-weight: 400; font-size: 11px; color: var(--ink-muted); letter-spacing: 0; }
  .room-dims { display: flex; align-items: center; gap: 6px; color: var(--ink-muted); font-size: 13px; }
  .room-dims input { width: 64px; }
  .spacer { flex: 1; }
  .header-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  input[type="number"], input[type="text"], select {
    background: var(--bg-canvas); border: 1px solid var(--border); color: var(--ink);
    border-radius: 6px; padding: 6px 8px; font-family: inherit; font-size: 13px;
  }
  input:focus, select:focus, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

  button {
    border: 1px solid var(--border); background: var(--bg-canvas); color: var(--ink);
    padding: 7px 12px; border-radius: 7px; font-size: 13px; font-weight: 500; cursor: pointer;
  }
  button:hover { border-color: var(--accent); }
  button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-contrast); }
  button.danger:hover { border-color: var(--danger); color: var(--danger); }
  button.ghost { background: transparent; border-color: transparent; }
  button.icon-btn { display: none; padding: 7px 9px; }

  .layout { display: grid; grid-template-columns: 236px 1fr 250px; min-height: 0; }
  aside { background: var(--bg-panel); overflow-y: auto; min-height: 0; }
  .palette { border-right: 1px solid var(--border); padding: 14px 12px 24px; }
  .props { border-left: 1px solid var(--border); padding: 14px 14px 24px; }

  .section-label { font-size: 11px; font-weight: 600; color: var(--ink-muted); margin: 18px 0 8px; }
  .section-label:first-child { margin-top: 0; }

  .palette-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .palette-item {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: 10px 6px 8px; background: var(--bg-canvas); border: 1px solid var(--border);
    border-radius: 8px; cursor: pointer; text-align: center;
  }
  .palette-item:hover { border-color: var(--accent); }
  .palette-item svg { display: block; overflow: visible; }
  .palette-item .pname { font-size: 11px; line-height: 1.25; color: var(--ink); }
  .palette-item .pdim { font-size: 10px; color: var(--ink-muted); }

  /* ---- canvas (infinite, pan + zoom) ---- */
  .canvas-area { position: relative; min-height: 0; min-width: 0; display: flex; }
  .canvas-wrap {
    flex: 1; min-width: 0; position: relative; overflow: hidden; touch-action: none;
    background-color: var(--bg-canvas);
    background-image:
      linear-gradient(to right, var(--grid-major) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-major) 1px, transparent 1px),
      linear-gradient(to right, var(--c2, var(--grid-minor)) 1px, transparent 1px),
      linear-gradient(to bottom, var(--c2, var(--grid-minor)) 1px, transparent 1px),
      linear-gradient(to right, var(--c3, var(--grid-fine)) 1px, transparent 1px),
      linear-gradient(to bottom, var(--c3, var(--grid-fine)) 1px, transparent 1px);
    background-size:
      var(--g1, 140px) var(--g1, 140px), var(--g1, 140px) var(--g1, 140px),
      var(--g2, 28px) var(--g2, 28px), var(--g2, 28px) var(--g2, 28px),
      var(--g3, 14px) var(--g3, 14px), var(--g3, 14px) var(--g3, 14px);
    background-position: var(--gx, 0px) var(--gy, 0px);
  }
  .canvas-wrap.space { cursor: grab; }
  .pipe-line { opacity: .28; transition: opacity .2s ease; }
  .canvas-wrap.pipes-on .pipe-line { opacity: 1; }
  .canvas-wrap.multi .handle { display: none !important; }
  .marquee { position: absolute; display: none; z-index: 24; pointer-events: none; border: 1.5px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent); border-radius: 2px; }
  .pal-search { width: 100%; margin-bottom: 12px; }
  .swatches { display: flex; gap: 6px; margin: 0 0 12px; }
  .swatch { width: 22px; height: 22px; border-radius: 50%; padding: 0; border: 2px solid transparent; }
  .swatch.on { border-color: var(--ink); }
  .canvas-wrap.panning { cursor: grabbing; }
  .canvas-wrap.drawing { cursor: crosshair; }
  .canvas-wrap.drawing .item { pointer-events: none; }
  .canvas-wrap.drawing svg * { pointer-events: none !important; }
  .canvas-stage { position: absolute; left: 0; top: 0; width: 0; height: 0; transform-origin: 0 0; }
  .room { position: absolute; left: 0; top: 0; width: 0; height: 0; }
  .layer { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: visible; pointer-events: none; }
  #labelsLayer { z-index: 26; }
  #issuesLayer { z-index: 28; }
  #overlay { z-index: 30; }
  @keyframes issueFlash { 0%, 100% { opacity: 1; } 50% { opacity: .15; } }
  .issue.flash { animation: issueFlash .45s ease 4; }

  .item {
    position: absolute; left: 0; top: 0;
    cursor: grab; user-select: none; touch-action: none;
  }
  .item .furniture-icon { position: absolute; inset: 0; pointer-events: none; overflow: visible; }
  .item.selected { outline: 2px solid var(--accent); outline-offset: 2px; z-index: 5; }
  .item.child-active { outline: 2px dashed var(--accent); outline-offset: 2px; z-index: 4; }

  .item .item-label {
    position: absolute; left: 50%; bottom: -19px; transform: translateX(-50%);
    font-size: 10px; white-space: nowrap; color: var(--ink-muted);
    background: var(--bg-panel); border: 1px solid var(--border);
    padding: 1px 6px; border-radius: 4px; pointer-events: none;
    opacity: 0; transition: opacity .12s ease; z-index: 4;
  }
  .item:hover .item-label, .item.selected .item-label { opacity: 1; }

  .item.seat {
    background: transparent; border: 2px dashed var(--ink-muted); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  .item.seat .item-label {
    position: static; transform: none; opacity: 1;
    background: transparent; border: none; padding: 0;
    font-size: 13px; font-weight: 600; color: var(--ink);
  }

  .handle {
    position: absolute; width: 14px; height: 14px;
    background: var(--accent); border: 2px solid var(--accent-contrast);
    display: none; z-index: 7;
  }
  .handle-length, .handle-depth, .handle-radius { border-radius: 3px; }
  .handle-length { cursor: ew-resize; }
  .handle-depth { cursor: ns-resize; }
  .handle-radius { cursor: ew-resize; }
  .handle-rotate, .handle-rotate-corner { border-radius: 50%; cursor: grab; }
  .item:hover .handle-length, .item.selected .handle-length,
  .item:hover .handle-depth, .item.selected .handle-depth,
  .item:hover .handle-radius, .item.selected .handle-radius { display: block; }
  .item.selected .handle-rotate, .item.selected .handle-rotate-corner { display: block; }

  /* ---- floating controls over canvas ---- */
  .tools {
    position: absolute; left: 14px; top: 14px; z-index: 25; display: flex; gap: 4px;
    background: var(--bg-panel); border: 1px solid var(--border); border-radius: 9px; padding: 4px;
    flex-wrap: wrap; max-width: calc(100% - 28px);
  }
  .tools button { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border-color: transparent; background: transparent; }
  .tools button:hover { border-color: var(--border); }
  .tools button.active { background: var(--accent); color: var(--accent-contrast); }
  .tools svg { flex: none; }

  .draw-bar {
    position: absolute; left: 14px; top: 62px; z-index: 25; display: none; align-items: center; gap: 10px;
    background: var(--bg-panel); border: 1px solid var(--accent); border-radius: 9px; padding: 6px 8px 6px 12px;
    font-size: 12px; color: var(--ink); max-width: calc(100% - 28px);
  }
  .draw-bar.show { display: flex; }
  .draw-bar label { display: flex; align-items: center; gap: 6px; color: var(--ink-muted); white-space: nowrap; }
  .draw-bar input[type="number"] { width: 62px; padding: 4px 6px; }
  .draw-bar span { line-height: 1.35; }
  .draw-bar button { padding: 5px 10px; white-space: nowrap; }

  .zoom-controls {
    position: absolute; right: 14px; bottom: 14px; z-index: 25; display: flex; gap: 6px;
    background: var(--bg-panel); border: 1px solid var(--border); border-radius: 8px; padding: 4px;
  }
  .zoom-controls button { padding: 6px 10px; }

  .issues {
    position: absolute; left: 14px; bottom: 14px; z-index: 25; display: flex; flex-direction: column; gap: 6px;
    max-width: min(380px, calc(100% - 150px));
  }
  .issues-pill { align-self: flex-start; background: var(--bg-panel); font-size: 12.5px; }
  .issues-pill.ok { color: var(--ink-muted); }
  .issues-pill.bad { border-color: var(--bad); color: var(--bad); font-weight: 600; }
  .issues-list {
    display: none; background: var(--bg-panel); border: 1px solid var(--bad); border-radius: 9px;
    max-height: 40vh; overflow: auto;
  }
  .issues.open .issues-list { display: block; }
  .issue-row {
    display: block; width: 100%; text-align: left; border: none; border-bottom: 1px solid var(--border);
    border-radius: 0; background: transparent; padding: 8px 12px; font-size: 12.5px; line-height: 1.35;
    font-family: "Inter", system-ui, sans-serif; font-weight: 400;
  }
  .issue-row:last-child { border-bottom: none; }
  .issue-row:hover { background: var(--bg-canvas); }
  .issue-row small { display: block; color: var(--ink-muted); font-size: 11px; margin-top: 1px; }
  .dim-hint {
    position: absolute; left: 50%; top: 14px; transform: translateX(-50%); z-index: 26; display: none;
    background: var(--bg-panel); border: 1px solid var(--accent); border-radius: 9px; padding: 6px 12px;
    font-size: 12px; white-space: nowrap; pointer-events: none;
  }
  .dim-hint.show { display: block; }
  .dim-hint b { color: var(--accent); }

  #notesLayer { z-index: 27; }
  .item.util { z-index: 3; }
  .item.seat.occupied { border-style: solid; border-color: var(--accent); }
  .item.seat.occupied .item-label { display: none; }
  .person-avatar { position: absolute; inset: 0; border-radius: 50%; overflow: hidden; pointer-events: none; background: var(--bg-panel); }
  .seat-name {
    position: absolute; left: 50%; top: 100%; margin-top: 3px; transform: translateX(-50%); white-space: nowrap;
    font-size: 11px; font-weight: 600; background: var(--bg-panel); border: 1px solid var(--border);
    border-radius: 5px; padding: 0 6px; pointer-events: none; z-index: 3; color: var(--ink);
  }
  .cm-text { width: 100%; resize: vertical; background: var(--bg-canvas); border: 1px solid var(--border); color: var(--ink);
    border-radius: 6px; padding: 7px 8px; font-family: inherit; font-size: 12.5px; line-height: 1.4; }
  .preset-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 12px; }
  .preset { padding: 4px 2px 3px; display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 10px; line-height: 1.15;
    font-family: "Inter", system-ui, sans-serif; font-weight: 400; text-align: center; }
  .preset.on { border-color: var(--accent); background: var(--bg-panel); outline: 2px solid var(--accent); }
  .tip {
    position: absolute; z-index: 40; max-width: 270px; pointer-events: none; display: none;
    background: var(--bg-panel); border: 1px solid var(--border); border-radius: 9px; padding: 8px 11px;
    font-size: 12.5px; line-height: 1.4; box-shadow: 0 6px 20px rgba(0,0,0,.18); white-space: pre-wrap; color: var(--ink);
  }
  .tip.show { display: block; }
  .tip-sub { color: var(--ink-muted); font-size: 11.5px; margin-top: 1px; }
  .tip-note { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--border); }
  .view-bar {
    position: absolute; top: 12px; right: 12px; z-index: 27; display: none; gap: 6px; align-items: center;
    background: var(--bg-panel); border: 1px solid var(--border); border-radius: 9px; padding: 4px 6px 4px 12px; font-size: 12px; color: var(--ink-muted);
  }
  body.view-only .view-bar { display: flex; }
  body.view-only header, body.view-only .palette, body.view-only .props, body.view-only .tools,
  body.view-only .draw-bar, body.view-only .issues, body.view-only .dim-hint, body.view-only .marquee { display: none !important; }
  body.view-only .app { grid-template-rows: 1fr; }
  body.view-only .layout { grid-template-columns: 1fr; }
  body.view-only .handle { display: none !important; }
  body.view-only .item { cursor: default; }
  body.view-only .zoom-controls { bottom: 12px; }
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: none; align-items: center; justify-content: center; z-index: 70; }
  .modal-overlay.show { display: flex; }
  .modal { background: var(--bg-panel); border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; width: min(580px, 92vw); max-height: 90vh; overflow: auto; }
  .modal h3 { margin: 0 0 6px; font-family: "Space Grotesk", sans-serif; font-size: 17px; }
  .modal p { margin: 0 0 12px; color: var(--ink-muted); font-size: 12.5px; line-height: 1.5; }
  .modal label { display: block; font-size: 12px; color: var(--ink-muted); margin: 10px 0 4px; }
  .modal input[type="text"], .modal textarea { width: 100%; background: var(--bg-canvas); border: 1px solid var(--border); color: var(--ink);
    border-radius: 6px; padding: 7px 8px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11.5px; }
  .modal textarea { resize: vertical; word-break: break-all; }
  .modal .row { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }

  .props-empty { color: var(--ink-muted); font-size: 13px; line-height: 1.5; margin-top: 4px; }
  .prop-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
  .prop-row label { color: var(--ink-muted); font-size: 12px; }
  .prop-row input[type="number"] { width: 78px; }
  .prop-row input[type="text"] { width: 100%; }
  .prop-row select { width: 120px; }
  .props-name { margin-bottom: 14px; }
  .props-name input { width: 100%; }
  .stat { display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 8px; color: var(--ink-muted); }
  .stat b { color: var(--ink); font-weight: 600; }
  .full-btn { width: 100%; margin-top: 8px; }

  .hint {
    color: var(--ink-muted); font-size: 11.5px; line-height: 1.6; margin-top: 16px;
    border-top: 1px solid var(--border); padding-top: 12px;
  }
  .hint div { margin-bottom: 3px; }
  kbd { background: var(--bg-canvas); border: 1px solid var(--border); border-radius: 4px; padding: 1px 5px; font-size: 10.5px; }

  .toast {
    position: fixed; bottom: 18px; left: 50%; transform: translate(-50%, 0);
    background: var(--ink); color: var(--bg-canvas); padding: 9px 16px; border-radius: 8px;
    font-size: 13px; opacity: 0; pointer-events: none; transition: opacity 0.2s ease; z-index: 50;
  }
  .toast.show { opacity: 1; }

  .confirm-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.35);
    display: none; align-items: center; justify-content: center; z-index: 60;
  }
  .confirm-overlay.show { display: flex; }
  .confirm-box { background: var(--bg-panel); border: 1px solid var(--border); border-radius: 10px; padding: 18px 20px; max-width: 300px; text-align: center; }
  .confirm-box p { margin: 0 0 14px; font-size: 13.5px; }
  .confirm-box .row { display: flex; gap: 8px; justify-content: center; }

  .scrim { position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 19; display: none; }

  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; }
    .dim-hint { display: none !important; }
    .palette, .props {
      position: fixed; top: 0; bottom: 0; width: min(80vw, 300px); z-index: 40;
      padding-top: calc(14px + env(safe-area-inset-top, 0px));
      padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px));
      transition: transform 0.22s ease; box-shadow: 0 0 24px rgba(0,0,0,0.25);
    }
    .scrim { z-index: 35; }
    .palette { left: 0; transform: translateX(-104%); }
    .props { right: 0; transform: translateX(104%); }
    .palette.open, .props.open { transform: translateX(0); }
    .scrim.show { display: block; }
    button.icon-btn { display: inline-flex; }
    .brand small { display: none; }
    .room-dims span.full-label { display: none; }
    .tools button span { display: none; }
  }
</style>
</head>
<body>

<div class="app">
  <header>
    <button class="icon-btn" id="openPalette" aria-label="Объекты" title="Объекты">▦</button>
    <div class="brand">Чертёжник<small>планировщик помещений</small></div>
    <button id="btnFit" title="Показать весь план">Вписать в экран</button>
    <div class="spacer"></div>
    <div class="header-actions">
      <button id="btnClear" class="ghost danger">Очистить мебель</button>
      <button id="btnShare">Поделиться / встроить</button>
      <button id="btnImport">Импорт JSON</button>
      <input type="file" id="fileInput" accept="application/json" style="display:none">
      <button id="btnExport" class="primary">Скачать план</button>
    </div>
    <button class="icon-btn" id="openProps" aria-label="Свойства" title="Свойства">☰</button>
  </header>

  <div class="layout">
    <aside class="palette" id="palette"><input type="text" id="palSearch" class="pal-search" placeholder="Поиск: стол, кресло, душ…"><div id="palList"></div></aside>

    <main class="canvas-area">
      <div class="canvas-wrap" id="canvasWrap">
        <div class="canvas-stage" id="stage">
          <div class="room" id="room">
            <svg id="geo" class="layer" preserveAspectRatio="none"></svg>
            <svg id="labelsLayer" class="layer" preserveAspectRatio="none"></svg>
            <svg id="notesLayer" class="layer" preserveAspectRatio="none"></svg>
            <svg id="issuesLayer" class="layer" preserveAspectRatio="none"></svg>
            <svg id="overlay" class="layer" preserveAspectRatio="none"></svg>
          </div>
        </div>
      </div>

      <div class="marquee" id="marquee"></div>
      <div class="tip" id="tip"></div>
      <div class="view-bar" id="viewBar"><span>Режим просмотра</span><button id="vbFit">Вписать</button><button id="vbEdit" class="primary">Редактировать</button></div>
      <div class="tools" id="tools">
        <button data-tool="select" class="active" title="Выбор и перемещение">
          <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 2l9 5-4 1.2L6.5 13z" fill="currentColor"/></svg><span>Выбор</span>
        </button>
        <button data-tool="room" title="Нарисовать комнату по точкам">
          <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 3h6l4 4v6H3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><span>Комната</span>
        </button>
