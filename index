  }
  function loadFromHash() {
    const h = parseHash();
    if (!h) return false;
    setViewOnly(true);
    decodePlan(h.flag, h.data).then(obj => {
      if (!obj || !Array.isArray(obj.items)) throw new Error("bad");
      rebuildFromState(obj);
