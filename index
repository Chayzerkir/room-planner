  function avatarSvg(p, px) { return `<svg width="${px}" height="${px}" viewBox="0 0 100 100" style="overflow:hidden;border-radius:50%">${avatarInner(p)}</svg>`; }
  function getPerson(id) { return state.people.find(p => p.id === id); }
