    const dot = (cx, cy, r, f, o) => `<circle cx="${cx}" cy="${cy}" r="${r}" fill="${f}"${o ? ` opacity="${o}"` : ""}/>`;
    switch (type) {
      case "table-rect":
        return `<rect x="0" y="0" width="${w}" height="${h}" rx="4" fill="${color}" stroke="${dk}" stroke-width="1.4"/>
                <rect x="4" y="4" width="${Math.max(0,w-8)}" height="${Math.max(0,h-8)}" rx="2" fill="none" stroke="${dk}" stroke-width="0.8" opacity="0.5"/>`;
      case "table-round":
        return `<ellipse cx="${w/2}" cy="${h/2}" rx="${w/2-1}" ry="${h/2-1}" fill="${color}" stroke="${dk}" stroke-width="1.4"/>
