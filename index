  // ---------------------------------------------------------------
  // Palette
  // ---------------------------------------------------------------
  function miniIcon(spec) {
    const maxDim = 34;
    const ratio = spec.w / spec.h;
    let iw, ih;
    if (ratio >= 1) { iw = maxDim; ih = maxDim / ratio; } else { ih = maxDim; iw = maxDim * ratio; }
    iw = Math.max(iw, 12); ih = Math.max(ih, 12);
    const pad = 5;
    const vw = maxDim + pad * 2, vh = maxDim + pad * 2;
    const inner = buildIconInner(spec.type, iw, ih, spec.color);
    const content = inner
      ? `<g transform="translate(${(vw-iw)/2},${(vh-ih)/2})">${inner}</g>`
      : (spec.shape === "ellipse"
          ? `<ellipse cx="${vw/2}" cy="${vh/2}" rx="${iw/2}" ry="${ih/2}" fill="${spec.color}" stroke="rgba(0,0,0,.4)"/>`
          : `<rect x="${(vw-iw)/2}" y="${(vh-ih)/2}" width="${iw}" height="${ih}" rx="2" fill="${spec.color}" stroke="rgba(0,0,0,.4)"/>`);
    return `<svg width="${vw}" height="${vh}" viewBox="0 0 ${vw} ${vh}">${content}</svg>`;
  }

  let palFilter = "";
  function buildPalette() {
    const list = els.palList;
